{
  "name": "anstoss",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "android": "npm run android --workspace @anstoss/mobile",
    "ios": "npm run ios --workspace @anstoss/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "npx patch-package && cd packages/shared && npx tsc || true",
    "audit:coverage": "tsx scripts/audit-coverage.ts",
    "codemod:colors": "jscodeshift -t scripts/codemods/no-raw-colors-codemod.ts --extensions=tsx --parser=tsx 'apps/mobile/app/**/*.tsx' 'apps/mobile/src/components/**/*.tsx'",
    "codemod:spacing": "jscodeshift -t scripts/codemods/no-raw-spacing-codemod.ts --extensions=tsx --parser=tsx 'apps/mobile/app/**/*.tsx' 'apps/mobile/src/components/**/*.tsx'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/glob": "^8.1.0",
    "@types/jscodeshift": "^17.3.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jscodeshift": "^17.3.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.0",
    "react-server-dom-webpack": "19.2.5",
    "tsx": "^4.21.0",
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react-server-dom-webpack": "19.2.5",
    "react-native": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/gradle-plugin": "0.76.9",
    "expo-application": "~6.0.2",
    "expo-auth-session": "~6.0.1",
    "expo-crypto": "~14.0.1",
    "expo-web-browser": "~14.0.1"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.1"
  }
}
