{
  "name": "anstoss",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "npm run test:store-zip && turbo test",
    "test:store-zip": "node --import tsx --test scripts/store-zip-integrity.test.ts",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "android": "npm run android --workspace @anstoss/mobile",
    "ios": "npm run ios --workspace @anstoss/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "npx patch-package && npx prisma generate --schema apps/api/prisma/schema.prisma && (cd packages/shared && npx tsc || true)",
    "audit:coverage": "tsx scripts/audit-coverage.ts",
    "audit:store": "tsx scripts/store-readiness.ts",
    "codemod:colors": "jscodeshift -t scripts/codemods/no-raw-colors-codemod.ts --extensions=tsx --parser=tsx 'apps/mobile/app/**/*.tsx' 'apps/mobile/src/components/**/*.tsx'",
    "codemod:spacing": "jscodeshift -t scripts/codemods/no-raw-spacing-codemod.ts --extensions=tsx --parser=tsx 'apps/mobile/app/**/*.tsx' 'apps/mobile/src/components/**/*.tsx'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/metro-config": "0.86.3",
    "@types/glob": "^8.1.0",
    "@types/jscodeshift": "^17.3.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "ajv": "6.15.0",
    "eslint": "^10.1.0",
    "glob": "7.2.3",
    "globals": "^17.4.0",
    "js-yaml": "5.5.0",
    "jscodeshift": "^17.3.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-safe-area-context": "5.7.0",
    "react-server-dom-webpack": "19.2.8",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.21.0",
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react-server-dom-webpack": "$react-server-dom-webpack",
    "jest-expo": {
      "react-server-dom-webpack": "$react-server-dom-webpack"
    },
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-test-renderer": "19.2.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/gradle-plugin": "0.86.3",
    "@expo/metro": "56.0.2",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    },
    "@xmldom/xmldom": "0.8.15",
    "decode-uri-component": "0.5.1",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.12",
    "expo-crypto": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "file-type": "21.3.4",
    "multer": "2.5.0",
    "body-parser": "2.4.0",
    "engine.io": "6.6.10",
    "proxy-addr": "2.0.8",
    "brace-expansion@^5.0.0": "5.0.12",
    "node-forge": "1.4.2",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "postcss": "8.5.26",
    "qs": "6.17.1",
    "tar": "7.5.17",
    "uuid": "npm:uuid@11.1.1",
    "xcode@3.0.1": {
      "uuid": "npm:uuid@11.1.1"
    }
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.1"
  }
}
