# Clerk
CLERK_SECRET_KEY=sk_test_...

# Neon (Postgres)
DATABASE_URL=postgresql://...@...neon.tech/anstoss?sslmode=require
DATABASE_URL_DIRECT=postgresql://...@...neon.tech/anstoss?sslmode=require

# Upstash Redis (HTTP — rate limiting)
UPSTASH_REDIS_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=...

# Redis (ioredis — Socket.io adapter + chat)
REDIS_URL=rediss://default:...@...upstash.io:6379

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=anstoss-assets
R2_PUBLIC_BASE_URL=https://assets.anstoss.app

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@anstoss.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry
SENTRY_DSN=https://...@sentry.io/...

# App
PORT=3001
NODE_ENV=development
MIN_APP_VERSION=1.0.0
RECOMMENDED_APP_VERSION=1.0.0
APP_URL=https://anstoss-api-production.up.railway.app
