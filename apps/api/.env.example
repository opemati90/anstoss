# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Neon (Postgres)
DATABASE_URL=postgresql://...@...neon.tech/anstoss?sslmode=require
# PgBouncer connection string (use for production)
DATABASE_URL_POOLED=postgresql://...@...neon.tech/anstoss?sslmode=require&pgbouncer=true

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=anstoss-assets
R2_PUBLIC_URL=https://assets.anstoss.app

# Resend (email)
RESEND_API_KEY=re_...

# Sentry
SENTRY_DSN=https://...@sentry.io/...

# App
PORT=3000
NODE_ENV=development
MIN_APP_VERSION=0.0.1
