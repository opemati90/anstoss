# Custom email-OTP auth (replaces Clerk)
# AUTH_JWT_SECRET: signs/verifies HS256 session JWTs. Use a long random string.
#   e.g. `openssl rand -hex 32`
# REQUIRED in production: run `openssl rand -hex 32` and paste the result.
# The app refuses to boot in production with this placeholder or a <32-char value.
AUTH_JWT_SECRET=__REPLACE_ME__run_openssl_rand_hex_32
# AUTH_OTP_PEPPER: HMAC key for hashing OTP codes at rest. Distinct from JWT secret.
#   e.g. `openssl rand -hex 32`
# REQUIRED in production: run `openssl rand -hex 32` (distinct from the JWT secret).
AUTH_OTP_PEPPER=__REPLACE_ME__run_openssl_rand_hex_32

# Clerk (legacy — being retired; CLERK_SECRET_KEY no longer used by the auth guard)
CLERK_SECRET_KEY=sk_test_...

# Database (Railway Postgres, EU West / Amsterdam — or a local Postgres for dev)
DATABASE_URL=postgresql://user:pass@host:5432/railway?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:pass@host:5432/railway?sslmode=require

# Upstash Redis (HTTP — rate limiting)
UPSTASH_REDIS_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=...

# Redis (ioredis — Socket.io adapter + chat)
REDIS_URL=rediss://default:...@...upstash.io:6379

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=anstoss-assets
R2_PUBLIC_BASE_URL=https://assets.anstoss.app

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@anstoss.app

# Stripe — test mode
# 1. Get the secret key from https://dashboard.stripe.com/test/apikeys
# 2. For local webhook signing, install Stripe CLI and run:
#      stripe listen --forward-to localhost:3001/billing/webhooks/stripe
#    The CLI prints a `whsec_…` value — paste it as STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry
SENTRY_DSN=https://...@sentry.io/...

# App
PORT=3001
NODE_ENV=development
MIN_APP_VERSION=1.0.0
RECOMMENDED_APP_VERSION=1.0.0
APP_URL=https://anstoss-api-production.up.railway.app

# Internal platform admin
# ADMIN_API_KEY is accepted by /admin/* for the static internal admin console.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
# Optional bootstrap allowlist for app-session JWT users before their User row
# has platformRole=PLATFORM_ADMIN.
INTERNAL_ADMIN_EMAILS=
# Broadcast pushes are disabled for launch. Do not enable until push opt-in,
# rate limits, approval confirmation, and store privacy copy are complete.
ENABLE_ADMIN_BROADCASTS=false

# Android App Links (optional for boot, required before Android store launch)
# Comma-separated SHA-256 signing-certificate fingerprints, e.g.
# AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
ANDROID_CERT_FINGERPRINTS=
