# Custom email-OTP auth (replaces Clerk)
# AUTH_JWT_SECRET: signs/verifies HS256 session JWTs. Use a long random string.
#   e.g. `openssl rand -hex 32`
# REQUIRED in production: run `openssl rand -hex 32` and paste the result.
# The app refuses to boot in production with this placeholder or a <32-char value.
AUTH_JWT_SECRET=__REPLACE_ME__run_openssl_rand_hex_32
# AUTH_OTP_PEPPER: HMAC key for hashing OTP codes at rest. Distinct from JWT secret.
#   e.g. `openssl rand -hex 32`
# REQUIRED in production: run `openssl rand -hex 32` (distinct from the JWT secret).
AUTH_OTP_PEPPER=__REPLACE_ME__run_openssl_rand_hex_32

# Clerk (legacy — being retired; CLERK_SECRET_KEY no longer used by the auth guard)
CLERK_SECRET_KEY=sk_test_...

# Database (Railway Postgres, EU West / Amsterdam — or a local Postgres for dev)
DATABASE_URL=postgresql://user:pass@host:5432/railway?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:pass@host:5432/railway?sslmode=require

# Upstash Redis (HTTP — rate limiting)
UPSTASH_REDIS_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=...

# Redis (ioredis — Socket.io adapter + chat)
REDIS_URL=rediss://default:...@...upstash.io:6379

# Chat translation is unavailable for this release. No new hosting is approved.
# Do not enable until a provider, privacy terms and operating budget are approved.
# A leftover LIBRETRANSLATE_URL alone must never enable translation.
CHAT_TRANSLATION_ENABLED=false

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=anstoss-assets
R2_PUBLIC_BASE_URL=https://assets.anstoss.app
# Private moderation evidence; activate bucket last after verifying this key.
# Token scope: Object Read & Write for anstoss-quarantine only.
R2_QUARANTINE_ACCESS_KEY_ID=
R2_QUARANTINE_SECRET_ACCESS_KEY=
R2_QUARANTINE_JURISDICTION=eu
R2_QUARANTINE_BUCKET=

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@anstoss.app

# Stripe — test mode
# 1. Get the secret key from https://dashboard.stripe.com/test/apikeys
# 2. For local webhook signing, install Stripe CLI and run:
#      stripe listen --forward-to localhost:3001/billing/webhooks/stripe
#    The CLI prints a `whsec_…` value — paste it as STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry
SENTRY_DSN=https://...@sentry.io/...

# App
PORT=3001
NODE_ENV=development
MIN_APP_VERSION=1.0.0
RECOMMENDED_APP_VERSION=1.0.0
APP_URL=https://anstoss-api-production.up.railway.app

# Internal platform admin
# ADMIN_API_KEY is accepted by /admin/* for the static internal admin console.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
# Optional bootstrap allowlist for app-session JWT users before their User row
# has platformRole=PLATFORM_ADMIN.
INTERNAL_ADMIN_EMAILS=
# Broadcast pushes are disabled for launch. Do not enable until push opt-in,
# rate limits, approval confirmation, and store privacy copy are complete.
ENABLE_ADMIN_BROADCASTS=false

# Android App Links (optional for boot, required before Android store launch)
# Comma-separated SHA-256 signing-certificate fingerprints, e.g.
# AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
ANDROID_CERT_FINGERPRINTS=

# Native Anstoss subscriptions — disabled until store/device launch gates pass.
ANSTOSS_IAP_ENABLED=false
# 32 random bytes encoded as 64 hex characters; server secret manager only.
ANSTOSS_IAP_ENCRYPTION_KEY=
ANSTOSS_IAP_APPLE_KEY_ID=
ANSTOSS_IAP_APPLE_ISSUER_ID=
ANSTOSS_IAP_APPLE_KEY_BASE64=
# Comma-separated base64 DER Apple root certificates.
ANSTOSS_IAP_APPLE_ROOTS_BASE64=
ANSTOSS_IAP_GOOGLE_KEY_BASE64=
# Optional local FILE alternatives (use FILE or BASE64, never both):
# ANSTOSS_IAP_APPLE_KEY_FILE=
# ANSTOSS_IAP_APPLE_ROOT_FILES=
# ANSTOSS_IAP_GOOGLE_KEY_FILE=
# Explicit QA club IDs only; sandbox grants must not reach normal clubs.
ANSTOSS_IAP_SANDBOX_CLUB_IDS=
# Google RTDN OIDC identity/audience; do not configure shared-app access.
ANSTOSS_IAP_GOOGLE_PUSH_AUDIENCE=
ANSTOSS_IAP_GOOGLE_PUSH_EMAIL=

# Social login — keep disabled until native/device QA and the migration pass.
# Uses existing AUTH_JWT_SECRET/AUTH_OTP_PEPPER; no Firebase hosting is needed.
ANSTOSS_SOCIAL_LOGIN_ENABLED=false
ANSTOSS_APPLE_SIGN_IN_ENABLED=false
# Anstoss-only Apple Sign in key, NOT an App Store billing or APNs key.
ANSTOSS_APPLE_SIGN_IN_TEAM_ID=
ANSTOSS_APPLE_SIGN_IN_KEY_ID=
# Absolute path to a securely mounted server-side .p8 file. Never bundle in app.
ANSTOSS_APPLE_SIGN_IN_KEY_FILE=
# 32 random bytes encoded as 64 hex characters; store in the secret manager.
# Retain this key and the Apple key for revocation if new login is disabled.
ANSTOSS_AUTH_ENCRYPTION_KEY=
