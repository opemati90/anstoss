// Anstoss — Prisma Schema
//
// Club operating model:
//   User (global) → Membership (club tenancy) → TeamGroup (umbrella) → Team (squad)
//   Team visibility and permissions flow through TeamAccess.
//   TeamMember remains player-specific roster metadata.
//
// Tenant scoping: clubId on every tenant-scoped model.
// Prisma middleware auto-injects clubId on all queries for tenant-scoped models.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

// ─── Global Models ──────────────────────────────────────

model User {
  id                 String           @id @default(cuid())
  clerkId            String?          @unique
  email              String?          @unique
  managedById        String?
  managedBy          User?            @relation("ManagedSubProfile", fields: [managedById], references: [id])
  managedSubProfiles User[]           @relation("ManagedSubProfile")
  name               String
  avatarUrl          String?
  registrationRole   RegistrationRole @default(PLAYER)
  // Platform-level role for the internal admin panel (apps/admin). NOT a
  // club role. Toggle to PLATFORM_ADMIN manually in the DB for support
  // staff / founders. Distinct namespace from MembershipRole so a normal
  // club Owner does not get platform-admin powers by default.
  platformRole       PlatformRole     @default(NONE)
  dateOfBirth        DateTime? // Nullable — age gate guard forces DOB entry if null
  preferredLanguage  String? // ISO-639-1, e.g. "de" — drives chat translation target
  // onboarding revamp: adult self-declaration (16+) for coaches, parents and
  // club admins, who are no longer asked for a date of birth. Players still
  // give their DOB (under-16 gate). Ignored whenever a real DOB is on file.
  adultConfirmedAt   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  memberships                    Membership[]
  teamMembers                    TeamMember[]
  teamAccess                     TeamAccess[]
  guardianRelationshipsAsParent  GuardianRelationship[]    @relation("GuardianParent")
  guardianRelationshipsAsPlayer  GuardianRelationship[]    @relation("GuardianPlayer")
  parentalConsentsAsPlayer       ParentalConsent[]         @relation("ParentalConsentPlayer")
  parentalConsentsAsGuardian     ParentalConsent[]         @relation("ParentalConsentGuardian")
  createdInvites                 Invite[]                  @relation("InviteCreator")
  acceptedInvites                Invite[]                  @relation("InviteAcceptor")
  rsvps                          Rsvp[]
  messages                       Message[]
  events                         Event[]                   @relation("EventCreator")
  pushTokens                     PushToken[]
  notificationPreferences        NotificationPreference[]
  inboxNotifications             InboxNotification[]
  joinRequests                   JoinRequest[]
  freeAgentProfile               FreeAgentProfile?
  sentTrialInvites               TrialInvite[]             @relation("TrialInviteSender")
  playerSearchesCreated          PlayerSearch[]            @relation("PlayerSearchCreator")
  injuriesAsPlayer               InjuryReport[]            @relation("InjuryPlayer")
  injuriesAsReporter             InjuryReport[]            @relation("InjuryReporter")
  dutyAssignments                TeamDutyAssignment[]      @relation("DutyAssignee")
  createdDutyAssignments         TeamDutyAssignment[]      @relation("DutyCreator")
  contributionPlansCreated       ContributionPlan[]        @relation("ContributionPlanCreator")
  contributionAssignments        ContributionAssignment[]  @relation("ContributionMember")
  contributionAssignmentsCreated ContributionAssignment[]  @relation("ContributionAssigner")
  contributionRecords            ContributionRecord[]      @relation("ContributionRecordMember")
  contributionReminders          ContributionReminder[]    @relation("ContributionReminderMember")
  conversationParticipants       ConversationParticipant[]
  directMessages                 DirectMessage[]           @relation("DirectMessageSender")
  eventReminderPreferences       EventReminderPreference[]
  messageReactions               MessageReaction[]
  messageReadReceipts            MessageReadReceipt[]
  messageReports                 MessageReport[]           @relation("MessageReportReporter")
  directMessageReports           DirectMessageReport[]     @relation("DirectMessageReportReporter")
  directMessageReactions         DirectMessageReaction[]   @relation("DirectMessageReactionUser") // chat revamp
  blocksMade                     UserBlock[]               @relation("UserBlockBlocker")
  blocksReceived                 UserBlock[]               @relation("UserBlockBlocked")
  pollVotes                      PollVote[]
  claimedRosterSlot              RosterSlot?
  createdBroadcasts              Broadcast[]               @relation("BroadcastCreator")
  eventCheckIns                  EventCheckIn[]
  // Events revamp: Fahrgemeinschaft
  carpoolRidesDriven             CarpoolRide[]
  carpoolSeats                   CarpoolSeat[]
  parentHandoffsCreated          ParentHandoff[]           @relation("ParentHandoffSource")
  parentHandoffsRedeemed         ParentHandoff[]           @relation("ParentHandoffRedeemer")
  channelMemberships             ChannelMember[]
  clubClaims                     ClubClaim[]               @relation("ClubClaimant")
  clubClaimEvidence              ClubClaimEvidence[]       @relation("ClubClaimEvidenceSubmitter")
  ownershipTransfersFrom         OwnershipTransfer[]       @relation("OwnershipTransferFrom")
  ownershipTransfersTo           OwnershipTransfer[]       @relation("OwnershipTransferTo")
  inviteCampaignsCreated         InviteCampaign[]          @relation("InviteCampaignCreator")
  inviteCampaignRedemptions      InviteRedemption[]
  platformAdminAccount           PlatformAdminAccount?
  // club-admin revamp: compliance records (Führungszeugnis & member documents)
  complianceRecords              ComplianceRecord[]        @relation("ComplianceRecordMember")
  complianceRecordsCreated       ComplianceRecord[]        @relation("ComplianceRecordCreator")
  complianceReminders            ComplianceReminder[]      @relation("ComplianceReminderMember")

  @@index([clerkId])
  @@index([email])
}

model AuthIdentityTombstone {
  id            String   @id @default(cuid())
  provider      String   @default("clerk")
  subjectHash   String
  deletedUserId String?
  reason        String
  createdAt     DateTime @default(now())

  @@unique([provider, subjectHash])
  @@index([deletedUserId])
}

// ─── Tenant Root ────────────────────────────────────────

model Club {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  badgeUrl     String?
  primaryColor String   @default("#1A1A18") // hex, overridden by coach
  welcomeText  String?
  city         String?
  searchText   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships             Membership[]
  teamGroups              TeamGroup[]
  teams                   Team[]
  teamAccess              TeamAccess[]
  guardianRelationships   GuardianRelationship[]
  parentalConsents        ParentalConsent[]
  externalTeamLinks       ExternalTeamLink[]
  importedFixtures        ImportedFixture[]
  fixtureOverlays         FixtureOverlay[]
  syncRuns                SyncRun[]
  events                  Event[]
  messages                Message[]
  chatRetentionSettings   ClubChatRetentionSettings?
  invites                 Invite[]
  stripeAccount           StripeAccount?
  subscriptions           Subscription[]
  paymentEvents           PaymentEvent[]
  contributionSettings    ClubContributionSettings?
  contributionPlans       ContributionPlan[]
  contributionAssignments ContributionAssignment[]
  contributionRecords     ContributionRecord[]
  contributionReminders   ContributionReminder[]
  supportActions          SupportAction[]
  auditLogs               AuditLog[]
  joinRequests            JoinRequest[]
  trialInvites            TrialInvite[]
  playerSearches          PlayerSearch[]
  injuryReports           InjuryReport[]
  dutyAssignments         TeamDutyAssignment[]
  conversations           Conversation[]
  channels                Channel[]
  sponsors                Sponsor[]
  featureFlagOverrides    FeatureFlagOverride[]
  eventCheckIns           EventCheckIn[]
  // Events revamp: Fahrgemeinschaft
  carpoolRides            CarpoolRide[]
  carpoolSeats            CarpoolSeat[]
  directoryEntry          ClubDirectoryEntry?
  claims                  ClubClaim[]
  disputes                ClubDispute[]
  ownershipTransfers      OwnershipTransfer[]
  inviteCampaigns         InviteCampaign[]
  inviteRedemptions       InviteRedemption[]
  entitlementGrants       EntitlementGrant[]
  planCompliance          ClubPlanCompliance?
  bankImportBatches       BankImportBatch[]
  bankTransactions        BankTransaction[]
  contributionMatches     ContributionMatch[]
  // club-admin revamp: compliance records
  complianceRecords       ComplianceRecord[]
  complianceReminders     ComplianceReminder[]
  matchLives              MatchLive[]
  matchLiveEvents         MatchLiveEvent[]

  @@index([slug])
  @@index([city])
  @@index([searchText])
}

enum ClubDirectorySource {
  DFBNET
  FUSSBALL_DE
  CSV_IMPORT
  MANUAL
}

model ClubDirectoryEntry {
  id             String              @id @default(cuid())
  source         ClubDirectorySource
  sourceId       String
  name           String
  normalizedName String
  slug           String              @unique
  city           String?
  state          String?
  postalCode     String?
  association    String?
  badgeUrl       String?
  websiteUrl     String?
  primaryColor   String              @default("#1A1A18")
  activeClubId   String?             @unique
  lastSeenAt     DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  activeClub Club?       @relation(fields: [activeClubId], references: [id], onDelete: SetNull)
  claims     ClubClaim[]

  @@unique([source, sourceId])
  @@index([normalizedName])
  @@index([city])
  @@index([state])
  @@index([association])
  @@index([activeClubId])
}

// ─── Platform admin role (orthogonal to club roles) ─────

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

enum ClubClaimKind {
  FIRST_CLAIM
  STAFF_CLAIM
}

enum ClubClaimStatus {
  SUBMITTED
  NEEDS_INFO
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ClubClaimEvidenceType {
  OFFICIAL_EMAIL
  EXISTING_STAFF_APPROVAL
  PUBLIC_CLUB_CONTACT
  PLATFORM_REVIEW
}

enum ClubDisputeStatus {
  OPEN
  FROZEN
  RESOLVED
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum OwnershipTransferChallengeAction {
  INITIATE
  ACCEPT
}

enum InviteCampaignType {
  IDENTITY_BOUND
  APPROVAL_REQUIRED
}

enum InviteCampaignStatus {
  ACTIVE
  PAUSED
  EXPIRED
  REVOKED
}

enum PlanTier {
  FREE
  PRO
  SCALE
}

enum PlanInterval {
  SIX_MONTHS
  TWELVE_MONTHS
}

enum EntitlementSource {
  PAID
  COMPLIMENTARY
  TRIAL
  MIGRATED
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum ClubPlanComplianceStatus {
  OVER_QUOTA
  RESOLVED
}

enum BankImportStatus {
  PARSED
  REVIEWED
  APPLIED
  FAILED
}

enum ContributionMatchStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
  REVERSED
}

// ─── Membership (User ↔ Club bridge) ────────────────────

enum MembershipRole {
  OWNER
  ADMIN
  COACH
  PLAYER
  PARENT
}

enum RegistrationRole {
  PLAYER
  PARENT
  COACH
  CLUB_ADMIN
  FREE_AGENT
}

enum ClubOperationalRole {
  SECRETARY
  TREASURER
  CAPTAIN
  TEAM_COORDINATOR
  BOARD_MEMBER
  SUPPORT_STAFF
}

enum TeamGroupType {
  SENIOR
  YOUTH
  MINI
  CUSTOM
}

enum TeamRole {
  HEAD_COACH
  ASSISTANT_COACH
  PLAYER
  PARENT
}

enum TeamAccessPhase {
  FULL
  TRIAL
}

enum TeamAccessStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum TeamMemberOperationalStatus {
  ACTIVE
  NEW_PLAYER
  INACTIVE
}

// Kader revamp: availability that is neither injury nor inactivity.
enum TeamMemberAbsence {
  NONE
  SUSPENDED
  AWAY
}

enum InviteKind {
  MEMBER_INVITE
  PARENT_APPROVAL
}

enum InviteDeliveryChannel {
  EMAIL
  LINK
}

enum InviteStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ParentalConsentStatus {
  REQUIRED
  PENDING
  APPROVED
  REJECTED
  // Privacy: guardian (or admin on the guardian's written request) withdrew a
  // previously approved consent, GDPR Art. 7(3).
  WITHDRAWN
}

enum ExternalDataProvider {
  API_FUSSBALL
  FUSSBALL_PUBLIC_PAGE
  LICENSED_FEED
  OPENLIGADB
  CLUB_MANUAL
  WIDGET_EMBED
  WEATHER
  MAPS
  VEO_MANUAL
}

enum ExternalTeamLinkStatus {
  ACTIVE
  NEEDS_REVIEW
  ERROR
  DISCONNECTED
}

enum ImportedFixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
  UNKNOWN
}

enum FixtureDataConfidence {
  OFFICIAL_PARTNER
  OFFICIAL_WIDGET
  UNOFFICIAL_PUBLIC
  COMMUNITY_OPEN
  CLUB_ENTERED
  MIXED
}

enum SyncRunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model Membership {
  id               String                @id @default(cuid())
  userId           String
  clubId           String
  role             MembershipRole        @default(PLAYER)
  operationalRoles ClubOperationalRole[] @default([])
  createdAt        DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@index([userId])
}

// Club authority is deliberately separate from membership. A claim never
// grants access until the approval transaction creates/elevates membership.
model ClubClaim {
  id                    String          @id @default(cuid())
  directoryEntryId      String
  clubId                String?
  claimantUserId        String
  kind                  ClubClaimKind
  desiredRole           MembershipRole
  requestedTeamIds      String[]        @default([])
  requestedTeamRoles    TeamRole[]      @default([])
  teamName              String?
  teamGroupType         TeamGroupType?
  requestedPrimaryColor String?
  externalTeamUrl       String?
  status                ClubClaimStatus @default(SUBMITTED)
  reviewerId            String?
  reviewNote            String?
  reviewedAt            DateTime?
  expiresAt             DateTime
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  directoryEntry ClubDirectoryEntry  @relation(fields: [directoryEntryId], references: [id], onDelete: Restrict)
  club           Club?               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  claimant       User                @relation("ClubClaimant", fields: [claimantUserId], references: [id], onDelete: Cascade)
  evidence       ClubClaimEvidence[]

  @@index([directoryEntryId, status])
  @@index([clubId, status])
  @@index([claimantUserId, status])
}

model ClubClaimEvidence {
  id            String                @id @default(cuid())
  claimId       String
  submittedById String
  type          ClubClaimEvidenceType
  value         String?
  createdAt     DateTime              @default(now())

  claim       ClubClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  submittedBy User      @relation("ClubClaimEvidenceSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model ClubDispute {
  id           String            @id @default(cuid())
  clubId       String
  openedById   String
  status       ClubDisputeStatus @default(OPEN)
  reason       String
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
}

model OwnershipTransfer {
  id          String                  @id @default(cuid())
  clubId      String
  fromUserId  String
  toUserId    String
  status      OwnershipTransferStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  club     Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fromUser User @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
  @@index([toUserId, status])
}

model OwnershipTransferChallenge {
  id           String                           @id @default(cuid())
  clubId       String
  transferId   String?
  actorUserId  String
  targetUserId String
  action       OwnershipTransferChallengeAction
  codeHash     String
  attempts     Int                              @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime                         @default(now())

  @@index([actorUserId, action, createdAt])
  @@index([transferId, action])
}

// ─── Team hierarchy ─────────────────────────────────────

model TeamGroup {
  id          String        @id @default(cuid())
  clubId      String
  type        TeamGroupType
  displayName String
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  club  Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teams Team[]

  @@unique([clubId, displayName])
  @@index([clubId, sortOrder])
}

model Team {
  id          String    @id @default(cuid())
  clubId      String
  groupId     String
  name        String
  displayName String
  ageGroup    String?
  squadLabel  String?
  squadTarget Int       @default(13)
  leagueName  String?
  seasonStart DateTime?
  joinCode    String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club              Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  group             TeamGroup              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  access            TeamAccess[]
  loanedPlayers     TeamAccess[]           @relation("LoanSource")
  guardianLinks     GuardianRelationship[]
  parentalConsents  ParentalConsent[]
  externalTeamLinks ExternalTeamLink[]
  importedFixtures  ImportedFixture[]
  invites           Invite[]
  inviteCampaigns   InviteCampaign[]
  events            Event[]
  messages          Message[]
  trialInvites      TrialInvite[]
  playerSearches    PlayerSearch[]
  injuryReports     InjuryReport[]
  dutyAssignments   TeamDutyAssignment[]
  rosterSlots       RosterSlot[]
  channels          Channel[]
  eventCheckIns     EventCheckIn[]

  @@unique([groupId, displayName])
  @@index([clubId])
  @@index([groupId])
  @@index([joinCode])
}

model TeamMember {
  id                String                      @id @default(cuid())
  teamId            String
  userId            String
  position          String?
  jerseyNumber      Int?
  operationalStatus TeamMemberOperationalStatus @default(ACTIVE)
  // Kader revamp: holiday / suspension, independent of injury and activity.
  absence           TeamMemberAbsence           @default(NONE)
  absenceUntil      DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamAccess {
  id        String           @id @default(cuid())
  clubId    String
  teamId    String
  userId    String
  role      TeamRole
  phase     TeamAccessPhase  @default(FULL)
  status    TeamAccessStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Loan fields — player temporarily assigned from another team
  loanedFromTeamId String?
  loanStartDate    DateTime?
  loanEndDate      DateTime?

  club           Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team           Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanedFromTeam Team? @relation("LoanSource", fields: [loanedFromTeamId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId, role])
  @@index([clubId])
  @@index([teamId])
  @@index([userId])
  @@index([loanedFromTeamId])
}

model GuardianRelationship {
  id           String   @id @default(cuid())
  clubId       String
  teamId       String?
  parentUserId String
  playerUserId String?
  childName    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club   Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team   Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent User  @relation("GuardianParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  player User? @relation("GuardianPlayer", fields: [playerUserId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([teamId])
  @@index([parentUserId])
  @@index([playerUserId])
}

model ParentalConsent {
  id                String                @id @default(cuid())
  clubId            String
  teamId            String
  playerUserId      String
  guardianEmail     String
  guardianUserId    String?
  status            ParentalConsentStatus @default(REQUIRED)
  requestedAt       DateTime              @default(now())
  approvedAt        DateTime?
  // Privacy: consent withdrawal (GDPR Art. 7(3)). withdrawnByUserId is a plain
  // id (no FK) so the record survives the actor's account deletion.
  withdrawnAt       DateTime?
  withdrawnByUserId String?
  withdrawalReason  String? // 'guardian_request' | 'admin_on_guardian_request' | 'guardian_account_deleted'
  withdrawalNote    String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player          User     @relation("ParentalConsentPlayer", fields: [playerUserId], references: [id], onDelete: Cascade)
  guardian        User?    @relation("ParentalConsentGuardian", fields: [guardianUserId], references: [id], onDelete: SetNull)
  approvalInvites Invite[]

  @@unique([teamId, playerUserId, guardianEmail])
  @@index([clubId])
  @@index([guardianEmail])
  @@index([guardianUserId])
}

enum ParentHandoffStatus {
  PENDING
  REDEEMED
  EXPIRED
}

/// Under-16 sign-up handoff. When a child hits the age gate at sign-up, their
/// self-created account is removed and this record carries their first name +
/// DOB to a guardian, who redeems the `code` to create a managed sub-profile
/// for the child. No clubId: this exists BEFORE any club association, so it is
/// intentionally outside tenant scoping.
model ParentHandoff {
  id               String              @id @default(cuid())
  code             String              @unique
  childFirstName   String
  childDateOfBirth DateTime
  guardianEmail    String
  sourceUserId     String?
  // onboarding review fix (H5): team of the invite the child followed, so
  // the guardian's team code is optional. Plain id, no relation (the handoff
  // is not tenant-scoped; a deleted team just falls back to the team code).
  teamId           String?
  status           ParentHandoffStatus @default(PENDING)
  expiresAt        DateTime
  redeemedByUserId String?
  redeemedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  source     User? @relation("ParentHandoffSource", fields: [sourceUserId], references: [id], onDelete: SetNull)
  redeemedBy User? @relation("ParentHandoffRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@unique([sourceUserId])
  @@index([guardianEmail])
  @@index([status])
}

// ─── Events + RSVP ─────────────────────────────────────

enum EventType {
  TRAINING
  MATCH
  OTHER
}

enum InjuryAvailabilityStatus {
  OUT
  DOUBTFUL
  DAY_TO_DAY
}

enum HomeAway {
  HOME
  AWAY
}

enum TeamDutyKind {
  JERSEY_CLEANUP
  BIB_CLEANUP
  // Kader revamp (Aufgaben): Kabinendienst after training / match.
  LOCKER_ROOM
}

enum TeamDutyStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model Event {
  id                 String    @id @default(cuid())
  clubId             String
  teamId             String
  externalMatchKey   String?   @unique
  title              String
  type               EventType @default(TRAINING)
  date               DateTime
  location           String?
  notes              String?
  createdById        String
  cancelledAt        DateTime?
  cancelReason       String?
  // Set when the date moves; replies given before it need confirming.
  rescheduledAt      DateTime?
  // Set when the event was materialised from a recurring series.
  seriesId           String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastRsvpReminderAt DateTime?
  // Events revamp (2026-09): matchday logistics live on the event itself.
  meetingAt          DateTime?
  meetingPoint       String?
  opponent           String?
  homeAway           HomeAway?
  fixtureId          String?   @unique
  squadPublishedAt   DateTime?
  carpoolEnabled     Boolean   @default(false)
  durationMin        Int?
  lineup             Json?
  // Events review fixes (2026-09-24): `title` of a derived title is only a
  // language-neutral fallback (opponent / "Training"); apps render it in the
  // reader's language. `importedFields` is the snapshot of what the last
  // fussball.de sync wrote, so a coach's own edits survive the next sync.
  autoTitle          Boolean   @default(false)
  importedFields     Json?

  club                Club                      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team                Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy           User                      @relation("EventCreator", fields: [createdById], references: [id])
  rsvps               Rsvp[]
  reminderPreferences EventReminderPreference[]
  checkIns            EventCheckIn[]
  series              EventSeries?              @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  fixture             ImportedFixture?          @relation(fields: [fixtureId], references: [id], onDelete: SetNull)
  carpoolRides        CarpoolRide[]
  matchLive           MatchLive?
  matchLiveEvents     MatchLiveEvent[]

  @@index([clubId])
  @@index([teamId])
  @@index([date])
  @@index([seriesId])
}

// A recurring event: the rule the occurrences were generated from. Every
// occurrence is a real Event row, so RSVPs, cancellation, check-in and feeds
// need nothing new; the series only remembers the rule for "this and
// following" edits.
model EventSeries {
  id               String    @id @default(cuid())
  clubId           String
  teamId           String
  createdById      String
  title            String
  type             EventType @default(TRAINING)
  intervalWeeks    Int       @default(1)
  // 0 = Sunday … 6 = Saturday (Europe/Berlin). Empty = weekday of startsAt.
  weekdays         Int[]     @default([])
  meetingOffsetMin Int?
  durationMin      Int?
  startsAt         DateTime
  until            DateTime
  location         String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  events Event[]

  @@index([teamId])
  @@index([clubId])
}

// Fahrgemeinschaft: a driver offers seats to an event; riders take them.
model CarpoolRide {
  id           String    @id @default(cuid())
  clubId       String
  eventId      String
  driverUserId String
  seats        Int
  departFrom   String?
  departAt     DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  club       Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driver     User          @relation(fields: [driverUserId], references: [id], onDelete: Cascade)
  seatsTaken CarpoolSeat[]

  @@unique([eventId, driverUserId])
  @@index([clubId])
  @@index([eventId])
}

model CarpoolSeat {
  id        String   @id @default(cuid())
  clubId    String
  rideId    String
  userId    String
  createdAt DateTime @default(now())

  club Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  ride CarpoolRide @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
  @@index([userId])
  @@index([clubId])
}

model EventReminderPreference {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([remindAt, sent])
}

model InjuryReport {
  id                  String                   @id @default(cuid())
  clubId              String
  teamId              String
  userId              String
  reportedById        String
  title               String
  notes               String?
  status              InjuryAvailabilityStatus @default(OUT)
  expectedReturnAt    DateTime?
  expectedReturnLabel String?
  clearedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  club       Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team       Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User @relation("InjuryPlayer", fields: [userId], references: [id], onDelete: Cascade)
  reportedBy User @relation("InjuryReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([clubId, teamId])
  @@index([userId])
  @@index([reportedById])
  @@index([clearedAt])
}

model TeamDutyAssignment {
  id             String         @id @default(cuid())
  clubId         String
  teamId         String
  assignedUserId String
  createdById    String
  kind           TeamDutyKind
  status         TeamDutyStatus @default(PENDING)
  dueDate        DateTime?
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  club         Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedUser User @relation("DutyAssignee", fields: [assignedUserId], references: [id], onDelete: Cascade)
  createdBy    User @relation("DutyCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clubId, teamId])
  @@index([assignedUserId])
  @@index([createdById])
}

enum RsvpStatus {
  YES
  MAYBE
  NO
}

model Rsvp {
  id             String     @id @default(cuid())
  eventId        String
  userId         String
  status         RsvpStatus
  reason         String? // injured | sick | work | vacation | personal | suspended | other | null
  note           String?    @db.VarChar(200)
  // In the coach's Kader for this event.
  nominated      Boolean    @default(false)
  // Was in the Kader, then answered Absage (or left the team). The coach sees
  // it until the Kader is saved again.
  squadDroppedAt DateTime?
  updatedAt      DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// ─── Chat ───────────────────────────────────────────────

model Message {
  id             String      @id @default(cuid())
  clubId         String
  teamId         String
  channelId      String?
  senderId       String?
  content        String
  sourceLanguage String? // ISO-639-1 detected by LibreTranslate; null if not yet detected
  messageType    MessageType @default(TEXT)
  attachmentUrl  String?
  attachmentMeta Json?
  replyToId      String?
  isAnnouncement Boolean     @default(false)
  isPinned       Boolean     @default(false)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())

  club         Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team         Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  channel      Channel?             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender       User?                @relation(fields: [senderId], references: [id])
  replyTo      Message?             @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]            @relation("MessageReply")
  reactions    MessageReaction[]
  reads        MessageReadReceipt[]
  reports      MessageReport[]
  poll         Poll?
  translations MessageTranslation[]

  @@index([teamId, createdAt])
  @@index([channelId, createdAt])
  @@index([clubId])
}

model ClubChatRetentionSettings {
  id                      String   @id @default(cuid())
  clubId                  String   @unique
  enabled                 Boolean  @default(false)
  messageRetentionDays    Int      @default(365)
  attachmentRetentionDays Int      @default(90)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

// Cached translations of Message.content per target language. Keyed by
// (messageId, targetLanguage) so each pair is computed at most once.
model MessageTranslation {
  id             String   @id @default(cuid())
  messageId      String
  targetLanguage String
  content        String
  createdAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, targetLanguage])
  @@index([messageId])
}

enum MessageType {
  TEXT
  VOICE
  IMAGE
  VIDEO
  FILE
  POLL
  RSVP_POLL
  LINEUP
  SYSTEM
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

// User-generated content moderation. Apple Guideline 1.2 requires a
// surface to report-this-content + block-this-user before approving any
// app with UGC chat. Reports are reviewed by club admins via the
// existing audit log; severe reports trigger a soft-delete on the
// message until reviewed.
model MessageReport {
  id                     String    @id @default(cuid())
  messageId              String
  reporterUserId         String
  reason                 String // free-text + canonical reasons (SPAM/ABUSE/INAPPROPRIATE/OTHER)
  evidenceContent        String?
  evidenceAttachmentUrl  String?
  evidenceAttachmentMeta Json?
  resolvedAt             DateTime?
  resolvedById           String?
  resolution             String? // free-text resolution note from admin
  createdAt              DateTime  @default(now())
  // Safeguarding review (2026-09-24): escalation to the platform queue,
  // overdue alerting and evidence retention. See docs/compliance/UGC_MODERATION.md.
  escalatedAt            DateTime?
  escalationReason       String? // 'staff_sender' | 'safeguarding' | 'overdue'
  overdueAlertedAt       DateTime?
  evidencePurgedAt       DateTime?

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User    @relation("MessageReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterUserId])
  @@index([messageId])
  @@index([reporterUserId])
  @@index([resolvedAt])
  @@index([resolvedAt, createdAt])
}

// Per-user block. Blocking is uni-directional: blocker no longer sees
// blocked's messages or DMs. Symmetric blocks happen when both users
// block each other. Chat history filter excludes blocked-by-caller
// messages; DM list hides conversations with blocked users.
model UserBlock {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
}

model Channel {
  id          String            @id @default(cuid())
  clubId      String
  teamId      String?
  slug        String
  kind        ChannelKind
  name        String
  description String?
  visibility  ChannelVisibility @default(MEMBERS)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  club     Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team     Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages Message[]
  members  ChannelMember[]

  @@unique([clubId, teamId, slug])
  @@index([teamId])
  @@index([clubId])
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  // Chat revamp: per-user mute. For non-CUSTOM channels this row only carries
  // the mute preference; it never grants access (access is role-derived).
  muted      Boolean   @default(false)
  mutedUntil DateTime?
  createdAt  DateTime  @default(now())
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
}

enum ChannelKind {
  TEAM
  COACHES
  PARENTS
  ANNOUNCEMENTS
  CLUB_NEWS
  CUSTOM
}

enum ChannelVisibility {
  MEMBERS
  COACHES_ONLY
  PARENTS_ONLY
  ADMINS_ONLY
}

model Poll {
  id          String    @id @default(cuid())
  messageId   String    @unique
  question    String
  multiSelect Boolean   @default(false)
  closesAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  index  Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  votedAt  DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
}

// ─── Invites ────────────────────────────────────────────

model Invite {
  id                 String                @id @default(cuid())
  clubId             String
  teamId             String
  parentalConsentId  String?
  code               String                @unique // 8-char alphanumeric
  kind               InviteKind            @default(MEMBER_INVITE)
  role               TeamRole
  phase              TeamAccessPhase       @default(FULL)
  deliveryChannel    InviteDeliveryChannel
  recipientEmail     String?
  linkedPlayerUserId String?
  guardianEmail      String?
  childName          String?
  createdById        String
  acceptedByUserId   String?
  status             InviteStatus          @default(PENDING)
  expiresAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parentalConsent ParentalConsent? @relation(fields: [parentalConsentId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy      User?            @relation("InviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([clubId])
  @@index([teamId])
  @@index([recipientEmail])
  @@index([linkedPlayerUserId])
  @@index([guardianEmail])
}

model InviteCampaign {
  id             String               @id @default(cuid())
  clubId         String
  teamId         String
  createdById    String
  type           InviteCampaignType
  role           TeamRole             @default(PLAYER)
  recipientEmail String?
  code           String               @unique
  maxUses        Int                  @default(1)
  useCount       Int                  @default(0)
  status         InviteCampaignStatus @default(ACTIVE)
  expiresAt      DateTime
  retiredAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  club        Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("InviteCampaignCreator", fields: [createdById], references: [id], onDelete: Cascade)
  redemptions InviteRedemption[]

  @@index([clubId, status])
  @@index([teamId, status])
  @@index([recipientEmail])
}

model InviteRedemption {
  id         String   @id @default(cuid())
  clubId     String
  campaignId String
  userId     String
  createdAt  DateTime @default(now())

  club     Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  campaign InviteCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([clubId, userId])
}

model ExternalTeamLink {
  id             String                 @id @default(cuid())
  clubId         String
  teamId         String
  provider       ExternalDataProvider
  externalTeamId String
  externalClubId String?
  externalUrl    String
  widgetId       String?
  widgetType     String?
  label          String
  status         ExternalTeamLinkStatus @default(ACTIVE)
  lastSyncedAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  club     Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fixtures ImportedFixture[]
  syncRuns SyncRun[]

  @@unique([teamId, provider, externalTeamId])
  @@index([clubId, teamId])
  @@index([clubId, status])
}

model ImportedFixture {
  id               String                @id @default(cuid())
  clubId           String
  teamId           String
  teamLinkId       String
  provider         ExternalDataProvider
  externalMatchId  String
  competition      String
  season           String?
  kickoffAt        DateTime
  status           ImportedFixtureStatus @default(SCHEDULED)
  homeTeam         String
  awayTeam         String
  homeLogo         String?
  awayLogo         String?
  venueName        String?
  pitchAddress     String?
  resultHome       Int?
  resultAway       Int?
  tableSnapshot    Json?
  rawPayload       Json
  sourceConfidence FixtureDataConfidence @default(UNOFFICIAL_PUBLIC)
  lastSeenAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamLink ExternalTeamLink @relation(fields: [teamLinkId], references: [id], onDelete: Cascade)
  overlay  FixtureOverlay?
  event    Event?

  @@unique([teamLinkId, externalMatchId])
  @@index([clubId, teamId, kickoffAt])
  @@index([clubId, lastSeenAt])
  // Cross-club live-window scan for the live poller (findLiveWindowLinks runs
  // every minute with no clubId filter).
  @@index([status, kickoffAt])
}

model FixtureOverlay {
  id              String    @id @default(cuid())
  clubId          String
  fixtureId       String    @unique
  arrivalTime     DateTime?
  meetingPoint    String?
  kitColor        String?
  travelNotes     String?
  squadDeadline   DateTime?
  veoLink         String?
  fieldLocks      Json?
  // Coach-built lineup for this fixture (fussball.de exposes no structured
  // amateur lineups, so the lineup feature is coach-driven). Stored as an
  // ApiFussballLineupSide-shaped object { formation, starters[], bench[] } for
  // the linked team; served by getFixtureLineup.
  lineupFormation String?
  lineup          Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  club    Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fixture ImportedFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([clubId, updatedAt])
}

model SyncRun {
  id            String               @id @default(cuid())
  clubId        String
  teamLinkId    String
  provider      ExternalDataProvider
  status        SyncRunStatus
  importedCount Int                  @default(0)
  updatedCount  Int                  @default(0)
  skippedCount  Int                  @default(0)
  parserVersion String
  errorSummary  String?
  startedAt     DateTime             @default(now())
  completedAt   DateTime?
  createdAt     DateTime             @default(now())

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teamLink ExternalTeamLink @relation(fields: [teamLinkId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([teamLinkId, createdAt])
}

// ─── Push Tokens ────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // Expo push token
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Notification Preferences ───────────────────────────

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String
  clubId             String
  teamId             String? // null = club-wide default
  mutedChat          Boolean  @default(false)
  mutedEvents        Boolean  @default(false)
  mutedAnnouncements Boolean  @default(false)
  quietStart         String? // "22:00" HH:mm
  quietEnd           String? // "07:00" HH:mm
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId, teamId])
  @@index([userId, clubId])
}

model FreeAgentProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  position         PlayerPosition?
  preferredFoot    PreferredFoot?
  city             String?
  bio              String?
  isOnTransferList Boolean             @default(false)
  visibility       FreeAgentVisibility @default(PRIVATE)
  // Wechselbörse search fields (2026-09)
  postalCode       String?             @db.VarChar(5)
  searchRadiusKm   Int?
  highestLeague    String?             @db.VarChar(32)
  currentClubName  String?             @db.VarChar(100)
  availableFrom    DateTime?           @db.Date
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience   FreeAgentExperience[]
  media        FreeAgentMedia[]
  trialInvites TrialInvite[]

  @@index([isOnTransferList, visibility])
  @@index([city])
  @@index([position])
  @@index([postalCode])
}

enum FreeAgentMediaType {
  PHOTO
  VIDEO
}

model FreeAgentMedia {
  id           String             @id @default(cuid())
  profileId    String
  type         FreeAgentMediaType
  url          String
  thumbnailUrl String?
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())

  profile FreeAgentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model FreeAgentExperience {
  id        String   @id @default(cuid())
  profileId String
  clubName  String
  roleLabel String
  fromYear  Int?
  toYear    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile FreeAgentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model TrialInvite {
  id                 String            @id @default(cuid())
  clubId             String
  freeAgentProfileId String
  teamId             String
  // Wechselbörse review L6: nullable so the thread survives staff deletion.
  sentByUserId       String?
  message            String?
  expiresAt          DateTime
  status             TrialInviteStatus @default(PENDING)
  respondedAt        DateTime?
  // Wechselbörse pipeline (2026-09)
  initiatedBy        TrialInitiator    @default(CLUB)
  playerSearchId     String?
  sessionEventIds    String[]          @default([])
  feedback           String?           @db.VarChar(1000)
  rating             Int?
  attended           Boolean?
  decisionMessage    String?           @db.VarChar(500)
  decidedAt          DateTime?
  decidedByUserId    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  club             Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  freeAgentProfile FreeAgentProfile @relation(fields: [freeAgentProfileId], references: [id], onDelete: Cascade)
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender           User?            @relation("TrialInviteSender", fields: [sentByUserId], references: [id], onDelete: SetNull)
  playerSearch     PlayerSearch?    @relation(fields: [playerSearchId], references: [id], onDelete: SetNull)
  joinRequest      JoinRequest?

  @@index([playerSearchId])
  @@index([clubId, status])
  @@index([freeAgentProfileId, status])
  @@index([teamId, status])
}

// ─── Billing ───────────────────────────────────────────

model StripeAccount {
  id                 String   @id @default(cuid())
  clubId             String   @unique
  stripeAccountId    String   @unique
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                     String   @id @default(cuid())
  clubId                 String
  stripeSubscriptionId   String   @unique
  status                 String
  plan                   String
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean  @default(false)
  lastStripeEventCreated Int?
  lastStripeEventId      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model PlanDefinition {
  id            String       @id @default(cuid())
  tier          PlanTier
  interval      PlanInterval
  version       Int
  priceCents    Int
  currency      String       @default("eur")
  teamLimit     Int
  playerLimit   Int
  features      String[]     @default([])
  stripePriceId String?      @unique
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  grants EntitlementGrant[]

  @@unique([tier, interval, version])
  @@index([tier, publishedAt])
}

model EntitlementGrant {
  id                   String            @id @default(cuid())
  clubId               String
  tier                 PlanTier
  source               EntitlementSource
  status               EntitlementStatus @default(ACTIVE)
  startsAt             DateTime          @default(now())
  expiresAt            DateTime?
  graceEndsAt          DateTime?
  reason               String?
  createdById          String?
  stripeSubscriptionId String?           @unique
  planDefinitionId     String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  club           Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  planDefinition PlanDefinition? @relation(fields: [planDefinitionId], references: [id], onDelete: SetNull)

  @@index([clubId, status, startsAt, expiresAt])
  @@index([planDefinitionId])
}

model ClubPlanCompliance {
  id                String                   @id @default(cuid())
  clubId            String                   @unique
  status            ClubPlanComplianceStatus @default(OVER_QUOTA)
  tier              PlanTier
  excessTeams       Int                      @default(0)
  excessPlayers     Int                      @default(0)
  detectedAt        DateTime                 @default(now())
  remediationEndsAt DateTime
  notifiedAt        DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id            String   @id @default(cuid())
  clubId        String
  stripeEventId String   @unique
  type          String
  amount        Int // cents
  currency      String   @default("eur")
  status        String
  createdAt     DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([createdAt])
}

model ClubContributionSettings {
  id                   String   @id @default(cuid())
  clubId               String   @unique
  enabled              Boolean  @default(false)
  autoRemindersEnabled Boolean  @default(true)
  defaultCurrency      String   @default("eur")
  // Optional manual bank-transfer ("pin the club IBAN") payment instructions
  // shown to members — the common German amateur-club flow where dues are
  // paid by SEPA transfer to the club account and reconciled manually.
  bankAccountHolder    String?
  bankIban             String?
  bankReference        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model ContributionPlan {
  id                 String                 @id @default(cuid())
  clubId             String
  name               String
  nameEn             String?
  nameDe             String?
  description        String?
  amount             Int
  currency           String                 @default("eur")
  cadence            ContributionCadence
  // Optional discount applied when the plan is paid yearly. 0-100
  // integer percent. Lets an admin offer "€25/mo OR €240/yr (20% off)"
  // on a single plan instead of two separate ones.
  yearlyDiscountPct  Int                    @default(0)
  targetRole         ContributionTargetRole
  dueDay             Int
  dueMonth           Int?
  graceDays          Int                    @default(0)
  reminderDaysBefore Int[]                  @default([])
  reminderDaysAfter  Int[]                  @default([])
  active             Boolean                @default(true)
  createdById        String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  club        Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("ContributionPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments ContributionAssignment[]
  records     ContributionRecord[]
  reminders   ContributionReminder[]

  @@index([clubId, active])
}

model ContributionAssignment {
  id             String    @id @default(cuid())
  clubId         String
  planId         String
  memberUserId   String
  assignedById   String
  startDate      DateTime  @default(now())
  endDate        DateTime?
  note           String?
  amountOverride Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan       ContributionPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  member     User                   @relation("ContributionMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  assignedBy User                   @relation("ContributionAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  records    ContributionRecord[]
  reminders  ContributionReminder[]

  @@unique([planId, memberUserId])
  @@index([clubId, memberUserId])
  @@index([clubId, endDate])
}

model BankImportBatch {
  id           String           @id @default(cuid())
  clubId       String
  importedById String
  contentHash  String
  fileName     String
  format       String
  status       BankImportStatus @default(PARSED)
  rowCount     Int              @default(0)
  error        String?
  // The uploaded bytes are parsed in memory and are never persisted. These
  // fields document/enforce the 24-hour ceiling if raw-object storage is ever
  // enabled; normalized transactions and confirmed matches remain auditable.
  rawExpiresAt DateTime         @map("expiresAt")
  rawObjectKey String?
  rawPurgedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  club         Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([clubId, contentHash])
  @@index([clubId, createdAt])
}

model BankTransaction {
  id          String   @id @default(cuid())
  clubId      String
  batchId     String
  bookedAt    DateTime
  amount      Int
  currency    String   @default("eur")
  payerName   String?
  ibanLast4   String?
  reference   String?
  externalId  String?
  fingerprint String
  createdAt   DateTime @default(now())

  club    Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  batch   BankImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matches ContributionMatch[]

  @@unique([clubId, fingerprint])
  @@index([batchId])
  @@index([clubId, bookedAt])
}

model ContributionMatch {
  id             String                  @id @default(cuid())
  clubId         String
  transactionId  String
  recordId       String
  amount         Int
  confidence     Int
  status         ContributionMatchStatus @default(SUGGESTED)
  confirmedById  String?
  confirmedAt    DateTime?
  reversedById   String?
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  club        Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  transaction BankTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  record      ContributionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([transactionId, recordId])
  @@index([clubId, status])
  @@index([recordId])
}

model ContributionRecord {
  id                 String                   @id @default(cuid())
  clubId             String
  planId             String
  assignmentId       String
  memberUserId       String
  periodStart        DateTime
  periodEnd          DateTime
  dueDate            DateTime
  amount             Int
  currency           String                   @default("eur")
  status             ContributionRecordStatus @default(PENDING)
  paidAmount         Int?
  manualPaidAmount   Int?                     @default(0)
  paidAt             DateTime?
  note               String?
  lastReminderKey    String?
  lastReminderSentAt DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan       ContributionPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignment ContributionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     User                   @relation("ContributionRecordMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  reminders  ContributionReminder[]
  matches    ContributionMatch[]

  @@unique([assignmentId, periodStart])
  @@index([clubId, memberUserId, dueDate])
}

model ContributionReminder {
  id           String                      @id @default(cuid())
  clubId       String
  planId       String
  assignmentId String
  recordId     String
  memberUserId String
  trigger      ContributionReminderTrigger
  reminderKey  String
  emailSent    Boolean                     @default(false)
  pushSent     Boolean                     @default(false)
  status       ContributionReminderStatus  @default(SKIPPED)
  message      String?
  sentAt       DateTime                    @default(now())

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan       ContributionPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignment ContributionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  record     ContributionRecord     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member     User                   @relation("ContributionReminderMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@unique([recordId, reminderKey])
  @@index([clubId, memberUserId, sentAt])
}

model SupportAction {
  id         String   @id @default(cuid())
  action     String // SUPPORT_NOTE; historical rows may contain older action labels.
  clubId     String
  actorId    String
  actorEmail String
  note       String?
  metadata   Json? // action-specific payload for future reviewed operations
  createdAt  DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([actorId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  clubId     String?
  type       String // AuditEventType values
  actorType  String // 'system' | 'user' | 'admin'
  actorId    String?
  actorLabel String?
  summary    String
  metadata   Json? // extra context
  createdAt  DateTime @default(now())

  club Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([type])
}

// ─── Join Request (request-to-join flow) ────────────────

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PlayerPosition {
  GK
  DEF
  MID
  FWD
}

enum ContributionCadence {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_OFF
}

enum ContributionTargetRole {
  PLAYER
  PARENT
  COACH
  ADMIN
  CUSTOM
}

enum ContributionRecordStatus {
  PENDING
  PAID
  PARTIAL
  WAIVED
  EXEMPT
}

enum ContributionReminderTrigger {
  AUTOMATIC
  MANUAL
}

enum ContributionReminderStatus {
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

enum FreeAgentVisibility {
  PUBLIC
  CLUB_ONLY
  PRIVATE
}

enum TrialInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
  REQUESTED
  OFFERED
  JOINED
  REJECTED
  WITHDRAWN
}

// ─── Wechselbörse (2026-09) ─────────────────────────────

enum TrialInitiator {
  CLUB
  PLAYER
}

enum PlayerSearchStatus {
  OPEN
  FILLED
  CLOSED
}

enum WechselReleaseStatus {
  PENDING
  GRANTED
  REFUSED
  NOT_NEEDED
}

// A club's "Gesuch", e.g. "Herren II sucht Torwart".
model PlayerSearch {
  id              String             @id @default(cuid())
  clubId          String
  teamId          String
  positions       PlayerPosition[]
  note            String?            @db.VarChar(500)
  status          PlayerSearchStatus @default(OPEN)
  // Wechselbörse review L6: nullable so the Gesuch survives staff deletion.
  createdByUserId String?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("PlayerSearchCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  trialInvites TrialInvite[]

  @@index([clubId, status])
  @@index([status, expiresAt])
  @@index([teamId])
}

model JoinRequest {
  id         String            @id @default(cuid())
  clubId     String
  teamId     String?
  userId     String
  role       TeamRole          @default(PLAYER)
  message    String?           @db.VarChar(500)
  status     JoinRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  revision   Int               @default(1)
  createdAt  DateTime          @default(now())

  // Aufnahmeantrag + Vereinswechsel tracking (2026-09). DFBnet stays the
  // system of record; these fields only mirror what the Passwart did there.
  trialInviteId     String?               @unique
  street            String?               @db.VarChar(120)
  postalCode        String?               @db.VarChar(5)
  city              String?               @db.VarChar(80)
  phone             String?               @db.VarChar(40)
  nationality       String?               @db.VarChar(60)
  previousClubName  String?               @db.VarChar(120)
  lastMatchDate     DateTime?             @db.Date
  sepaConsentAt     DateTime?
  parentalConsentAt DateTime?
  releaseStatus     WechselReleaseStatus?
  passApplicationAt DateTime?             @db.Date
  eligibleFrom      DateTime?             @db.Date

  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  trialInvite TrialInvite? @relation(fields: [trialInviteId], references: [id], onDelete: SetNull)

  @@unique([clubId, userId])
  @@index([clubId, status])
}

// ─── Direct Messages ────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([clubId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime     @default(now())
  // Chat revamp: per-user DM mute
  muted          Boolean      @default(false)
  mutedUntil     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("DirectMessageSender", fields: [senderId], references: [id])
  content        String
  sourceLanguage String?
  // Chat revamp: DM attachments + replies (migration 20260924170000_dm_attachments)
  messageType    MessageType  @default(TEXT)
  attachmentUrl  String?
  attachmentMeta Json?
  replyToId      String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  replyTo      DirectMessage?             @relation("DirectMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      DirectMessage[]            @relation("DirectMessageReply")
  translations DirectMessageTranslation[]
  reports      DirectMessageReport[]
  reactions    DirectMessageReaction[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

// Chat revamp: reactions on direct messages (same emoji set as channels).
model DirectMessageReaction {
  id              String   @id @default(cuid())
  directMessageId String
  userId          String
  emoji           String
  createdAt       DateTime @default(now())

  directMessage DirectMessage @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  user          User          @relation("DirectMessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, userId, emoji])
  @@index([directMessageId])
}

model DirectMessageReport {
  id                     String    @id @default(cuid())
  directMessageId        String
  reporterUserId         String
  reason                 String
  evidenceContent        String?
  // Chat revamp: snapshot of a reported attachment
  evidenceAttachmentUrl  String?
  evidenceAttachmentMeta Json?
  resolvedAt             DateTime?
  resolvedById           String?
  resolution             String?
  createdAt              DateTime  @default(now())
  // Safeguarding review (2026-09-24): escalation to the platform queue,
  // overdue alerting and evidence retention. See docs/compliance/UGC_MODERATION.md.
  escalatedAt            DateTime?
  escalationReason       String? // 'staff_sender' | 'safeguarding' | 'overdue'
  overdueAlertedAt       DateTime?
  evidencePurgedAt       DateTime?

  directMessage DirectMessage @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  reporter      User          @relation("DirectMessageReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, reporterUserId])
  @@index([directMessageId])
  @@index([reporterUserId])
  @@index([resolvedAt])
  @@index([resolvedAt, createdAt])
}

model DirectMessageTranslation {
  id              String   @id @default(cuid())
  directMessageId String
  targetLanguage  String
  content         String
  createdAt       DateTime @default(now())

  directMessage DirectMessage @relation(fields: [directMessageId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, targetLanguage])
  @@index([directMessageId])
}

// ─── Roster Slots ────────────────────────────────────────

model RosterSlot {
  id              String          @id @default(cuid())
  teamId          String
  fullName        String
  phone           String?
  dateOfBirth     DateTime?
  position        PlayerPosition?
  jerseyNumber    Int?
  claimedByUserId String?         @unique
  claimedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  claimedBy User? @relation(fields: [claimedByUserId], references: [id])

  @@index([teamId])
  @@index([teamId, claimedByUserId])
  @@index([phone])
}

// ─── Sponsor logos (Plus feature) ──────────────────────
//
// Clubs on the PREMIUM plan can upload kit-sponsor logos and surface
// them across the app (home screen strip, profile page, etc.).
// Reads are unauthenticated-by-plan — once a club downgrades, their
// existing sponsors stay visible & deletable so they can clean up,
// but new writes are gated on the `sponsor_logos` entitlement.

model Sponsor {
  id           String   @id @default(cuid())
  clubId       String
  name         String
  logoUrl      String
  linkUrl      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([clubId, displayOrder])
}

// ─── Club-admin revamp: compliance records ─────────────
// Führungszeugnis (youth staff), Spielerpass, medical/first-aid certificates
// and member documents without expiry (SEPA mandate, data consent).
enum ComplianceKind {
  FUEHRUNGSZEUGNIS
  SPIELERPASS
  MEDICAL_CHECK
  VACCINATION_TETANUS
  FIRST_AID_CERT
  SEPA_MANDATE
  DATA_CONSENT
}

/// club-admin revamp. Retention (§72a(5) SGB VIII, DSGVO Art. 5(1)(e)):
/// rows are deleted in the same transaction that removes a member from the
/// club (leave/remove) and the Führungszeugnis row when a member is offboarded
/// from staff; ComplianceRetentionWorker sweeps anything left behind nightly
/// (see docs/compliance/RELEASE_GATE.md). onDelete: Cascade on club and member
/// is deliberate: erasing a club or a person erases their certificates too.
model ComplianceRecord {
  id           String         @id @default(cuid())
  clubId       String
  memberUserId String
  kind         ComplianceKind
  issuedAt     DateTime?
  expiresAt    DateTime?
  documentUrl  String?
  note         String?        @db.VarChar(500)
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  club      Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member    User  @relation("ComplianceRecordMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ComplianceRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([clubId, memberUserId, kind])
  @@index([clubId, kind])
}

/// club-admin revamp: last compliance reminder per member + document kind,
/// so an admin can nudge a person at most once per 24 hours.
model ComplianceReminder {
  id           String         @id @default(cuid())
  clubId       String
  memberUserId String
  kind         ComplianceKind
  sentAt       DateTime       @default(now())

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member User @relation("ComplianceReminderMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@unique([clubId, memberUserId, kind])
}

// ─── Admin V2 ───────────────────────────────────────────

/// Broadcast push sent to a segment of users from the internal admin
/// console. Persisted so we can audit who sent what, when, and with what
/// delivery stats. Status transitions: DRAFT -> SENDING -> SENT | FAILED.
model Broadcast {
  id             String    @id @default(cuid())
  title          String
  body           String
  // 'ALL' | 'PREMIUM' | 'FREE' | 'CLUB:<clubId>'
  segment        String
  status         String    @default("DRAFT")
  createdById    String
  createdBy      User      @relation("BroadcastCreator", fields: [createdById], references: [id])
  recipientCount Int       @default(0)
  successCount   Int       @default(0)
  failureCount   Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

/// Per-club entitlement override. Layered on top of the plan-derived
/// feature list inside BillingService.getEntitlements:
///   enabled=true  -> ADD the feature (comp it on FOUNDATION)
///   enabled=false -> REMOVE the feature (revoke even on PREMIUM)
/// Reason + expiresAt are advisory. Unique on (clubId, featureSlug) so
/// each feature has at most one override per club.
model FeatureFlagOverride {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  featureSlug String
  enabled     Boolean
  reason      String?
  createdById String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([clubId, featureSlug])
  @@index([clubId])
}

/// Generic key/value store for runtime-tunable platform settings.
/// Used for MIN_APP_VERSION, RECOMMENDED_APP_VERSION, force-update copy,
/// announcement banner text, and any other value the platform admin
/// wants to change without redeploying. Values are stored as strings;
/// callers parse to richer types.
model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model PlatformAdminAccount {
  id                 String    @id @default(cuid())
  userId             String    @unique
  loginIdentifier    String    @unique
  passwordHash       String
  sessionVersion     Int       @default(1)
  mustRotatePassword Boolean   @default(true)
  disabledAt         DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([disabledAt])
}

// ─── Event Check-In ─────────────────────────────────────

model EventCheckIn {
  id          String   @id @default(cuid())
  clubId      String
  teamId      String
  eventId     String
  userId      String
  checkedInAt DateTime @default(now())

  club  Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([clubId, checkedInAt])
  @@map("event_check_ins")
}

// ─── Email OTP Authentication ───────────────────────────
//
// Custom email one-time-passcode auth (replaces Clerk). A code is requested
// for an email, hashed (HMAC-SHA256 w/ AUTH_OTP_PEPPER) and stored here; the
// plaintext is only ever emailed. Verification is single-use, expiring, and
// attempt-capped. Not tenant-scoped — auth precedes club selection.
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// ── Notifications inbox (2026-11 redesign, screen 09) ──────────────────────
// One row per recipient for every inbox-worthy push (events, join requests,
// dues, trials, consent, moderation…). Chat traffic is excluded — chat has its
// own unread counts. Template pushes store `type` + `data` and are rendered in
// the reader's current language on read; computed pushes store the rendered
// `title`/`body` in the recipient's language at write time.
// Per-user, so not tenant-scoped (see TENANT_UNSCOPED_MODELS); always queried
// by userId.
model InboxNotification {
  id        String    @id @default(cuid())
  userId    String
  clubId    String?
  teamId    String?
  type      String
  data      Json?
  title     String?
  body      String?
  target    Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@index([createdAt])
}

// ── Coach-recorded live match (2026-11 redesign, screen 14) ────────────────
enum MatchLiveStatus {
  NOT_STARTED
  FIRST_HALF
  HALF_TIME
  SECOND_HALF
  FINISHED
}

enum MatchLiveEventKind {
  GOAL
  CONCEDED
  YELLOW
  RED
  SUB
}

/// Running state of a MATCH event, tracked by its coach. Score is from the
/// team's point of view; the event's homeAway maps it onto home/away.
model MatchLive {
  eventId      String          @id
  clubId       String
  teamId       String
  status       MatchLiveStatus @default(NOT_STARTED)
  goalsFor     Int             @default(0)
  goalsAgainst Int             @default(0)
  kickoffAt    DateTime?
  halfTimeAt   DateTime?
  secondHalfAt DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  club  Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
}

/// One recorded moment (goal, card, substitution). Soft-deleted on undo so the
/// score can be recomputed and the audit trail kept.
model MatchLiveEvent {
  id            String             @id @default(cuid())
  clubId        String
  eventId       String
  kind          MatchLiveEventKind
  minute        Int
  playerUserId  String?
  playerName    String?
  relatedUserId String?
  relatedName   String?
  createdById   String
  createdAt     DateTime           @default(now())
  deletedAt     DateTime?

  club  Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, deletedAt, minute])
  @@index([clubId])
}
