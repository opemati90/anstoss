// Anstoss — Prisma Schema
//
// Club operating model:
//   User (global) → Membership (club tenancy) → TeamGroup (umbrella) → Team (squad)
//   Team visibility and permissions flow through TeamAccess.
//   TeamMember remains player-specific roster metadata.
//
// Tenant scoping: clubId on every tenant-scoped model.
// Prisma middleware auto-injects clubId on all queries for tenant-scoped models.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

// ─── Global Models ──────────────────────────────────────

model User {
  id                 String           @id @default(cuid())
  clerkId            String?          @unique
  email              String?          @unique
  managedById        String?
  managedBy          User?            @relation("ManagedSubProfile", fields: [managedById], references: [id])
  managedSubProfiles User[]           @relation("ManagedSubProfile")
  name               String
  avatarUrl          String?
  registrationRole   RegistrationRole @default(PLAYER)
  // Platform-level role for the internal admin panel (apps/admin). NOT a
  // club role. Toggle to PLATFORM_ADMIN manually in the DB for support
  // staff / founders. Distinct namespace from MembershipRole so a normal
  // club Owner does not get platform-admin powers by default.
  platformRole       PlatformRole     @default(NONE)
  dateOfBirth        DateTime? // Nullable — age gate guard forces DOB entry if null
  preferredLanguage  String? // ISO-639-1, e.g. "de" — drives chat translation target
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  memberships                    Membership[]
  teamMembers                    TeamMember[]
  teamAccess                     TeamAccess[]
  guardianRelationshipsAsParent  GuardianRelationship[]    @relation("GuardianParent")
  guardianRelationshipsAsPlayer  GuardianRelationship[]    @relation("GuardianPlayer")
  parentalConsentsAsPlayer       ParentalConsent[]         @relation("ParentalConsentPlayer")
  parentalConsentsAsGuardian     ParentalConsent[]         @relation("ParentalConsentGuardian")
  createdInvites                 Invite[]                  @relation("InviteCreator")
  acceptedInvites                Invite[]                  @relation("InviteAcceptor")
  rsvps                          Rsvp[]
  messages                       Message[]
  events                         Event[]                   @relation("EventCreator")
  pushTokens                     PushToken[]
  notificationPreferences        NotificationPreference[]
  joinRequests                   JoinRequest[]
  freeAgentProfile               FreeAgentProfile?
  sentTrialInvites               TrialInvite[]             @relation("TrialInviteSender")
  injuriesAsPlayer               InjuryReport[]            @relation("InjuryPlayer")
  injuriesAsReporter             InjuryReport[]            @relation("InjuryReporter")
  dutyAssignments                TeamDutyAssignment[]      @relation("DutyAssignee")
  createdDutyAssignments         TeamDutyAssignment[]      @relation("DutyCreator")
  contributionPlansCreated       ContributionPlan[]        @relation("ContributionPlanCreator")
  contributionAssignments        ContributionAssignment[]  @relation("ContributionMember")
  contributionAssignmentsCreated ContributionAssignment[]  @relation("ContributionAssigner")
  contributionRecords            ContributionRecord[]      @relation("ContributionRecordMember")
  contributionReminders          ContributionReminder[]    @relation("ContributionReminderMember")
  conversationParticipants       ConversationParticipant[]
  directMessages                 DirectMessage[]           @relation("DirectMessageSender")
  eventReminderPreferences       EventReminderPreference[]
  messageReactions               MessageReaction[]
  messageReadReceipts            MessageReadReceipt[]
  messageReports                 MessageReport[]           @relation("MessageReportReporter")
  blocksMade                     UserBlock[]               @relation("UserBlockBlocker")
  blocksReceived                 UserBlock[]               @relation("UserBlockBlocked")
  pollVotes                      PollVote[]
  claimedRosterSlot              RosterSlot?

  @@index([clerkId])
  @@index([email])
}

// ─── Tenant Root ────────────────────────────────────────

model Club {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  badgeUrl     String?
  primaryColor String   @default("#1A1A18") // hex, overridden by coach
  welcomeText  String?
  city         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships             Membership[]
  teamGroups              TeamGroup[]
  teams                   Team[]
  teamAccess              TeamAccess[]
  guardianRelationships   GuardianRelationship[]
  parentalConsents        ParentalConsent[]
  externalTeamLinks       ExternalTeamLink[]
  importedFixtures        ImportedFixture[]
  fixtureOverlays         FixtureOverlay[]
  syncRuns                SyncRun[]
  events                  Event[]
  messages                Message[]
  invites                 Invite[]
  stripeAccount           StripeAccount?
  subscriptions           Subscription[]
  paymentEvents           PaymentEvent[]
  contributionSettings    ClubContributionSettings?
  contributionPlans       ContributionPlan[]
  contributionAssignments ContributionAssignment[]
  contributionRecords     ContributionRecord[]
  contributionReminders   ContributionReminder[]
  supportActions          SupportAction[]
  auditLogs               AuditLog[]
  joinRequests            JoinRequest[]
  trialInvites            TrialInvite[]
  injuryReports           InjuryReport[]
  dutyAssignments         TeamDutyAssignment[]
  conversations           Conversation[]
  channels                Channel[]
  sponsors                Sponsor[]

  @@index([slug])
  @@index([city])
}

// ─── Platform admin role (orthogonal to club roles) ─────

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

// ─── Membership (User ↔ Club bridge) ────────────────────

enum MembershipRole {
  OWNER
  ADMIN
  COACH
  PLAYER
  PARENT
}

enum RegistrationRole {
  PLAYER
  PARENT
  COACH
  CLUB_ADMIN
  FREE_AGENT
}

enum ClubOperationalRole {
  SECRETARY
  TREASURER
  CAPTAIN
  TEAM_COORDINATOR
  BOARD_MEMBER
  SUPPORT_STAFF
}

enum TeamGroupType {
  SENIOR
  YOUTH
  MINI
  CUSTOM
}

enum TeamRole {
  HEAD_COACH
  ASSISTANT_COACH
  PLAYER
  PARENT
}

enum TeamAccessPhase {
  FULL
  TRIAL
}

enum TeamAccessStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum TeamMemberOperationalStatus {
  ACTIVE
  NEW_PLAYER
  INACTIVE
}

enum InviteKind {
  MEMBER_INVITE
  PARENT_APPROVAL
}

enum InviteDeliveryChannel {
  EMAIL
  LINK
}

enum InviteStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ParentalConsentStatus {
  REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ExternalDataProvider {
  API_FUSSBALL
  FUSSBALL_PUBLIC_PAGE
  OPENLIGADB
  CLUB_MANUAL
  WIDGET_EMBED
  WEATHER
  MAPS
  VEO_MANUAL
}

enum ExternalTeamLinkStatus {
  ACTIVE
  NEEDS_REVIEW
  ERROR
  DISCONNECTED
}

enum ImportedFixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
  UNKNOWN
}

enum FixtureDataConfidence {
  OFFICIAL_PARTNER
  OFFICIAL_WIDGET
  UNOFFICIAL_PUBLIC
  COMMUNITY_OPEN
  CLUB_ENTERED
  MIXED
}

enum SyncRunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model Membership {
  id               String                @id @default(cuid())
  userId           String
  clubId           String
  role             MembershipRole        @default(PLAYER)
  operationalRoles ClubOperationalRole[] @default([])
  createdAt        DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@index([userId])
}

// ─── Team hierarchy ─────────────────────────────────────

model TeamGroup {
  id          String        @id @default(cuid())
  clubId      String
  type        TeamGroupType
  displayName String
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  club  Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teams Team[]

  @@unique([clubId, displayName])
  @@index([clubId, sortOrder])
}

model Team {
  id          String    @id @default(cuid())
  clubId      String
  groupId     String
  name        String
  displayName String
  ageGroup    String?
  squadLabel  String?
  squadTarget Int       @default(13)
  leagueName  String?
  seasonStart DateTime?
  joinCode    String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club              Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  group             TeamGroup              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  access            TeamAccess[]
  loanedPlayers     TeamAccess[]           @relation("LoanSource")
  guardianLinks     GuardianRelationship[]
  parentalConsents  ParentalConsent[]
  externalTeamLinks ExternalTeamLink[]
  importedFixtures  ImportedFixture[]
  invites           Invite[]
  events            Event[]
  messages          Message[]
  trialInvites      TrialInvite[]
  injuryReports     InjuryReport[]
  dutyAssignments   TeamDutyAssignment[]
  rosterSlots       RosterSlot[]
  channels          Channel[]

  @@unique([groupId, displayName])
  @@index([clubId])
  @@index([groupId])
  @@index([joinCode])
}

model TeamMember {
  id                String                      @id @default(cuid())
  teamId            String
  userId            String
  position          String?
  jerseyNumber      Int?
  operationalStatus TeamMemberOperationalStatus @default(ACTIVE)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamAccess {
  id        String           @id @default(cuid())
  clubId    String
  teamId    String
  userId    String
  role      TeamRole
  phase     TeamAccessPhase  @default(FULL)
  status    TeamAccessStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Loan fields — player temporarily assigned from another team
  loanedFromTeamId String?
  loanStartDate    DateTime?
  loanEndDate      DateTime?

  club           Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team           Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanedFromTeam Team? @relation("LoanSource", fields: [loanedFromTeamId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId, role])
  @@index([clubId])
  @@index([teamId])
  @@index([userId])
  @@index([loanedFromTeamId])
}

model GuardianRelationship {
  id           String   @id @default(cuid())
  clubId       String
  teamId       String?
  parentUserId String
  playerUserId String?
  childName    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club   Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team   Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent User  @relation("GuardianParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  player User? @relation("GuardianPlayer", fields: [playerUserId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([teamId])
  @@index([parentUserId])
  @@index([playerUserId])
}

model ParentalConsent {
  id             String                @id @default(cuid())
  clubId         String
  teamId         String
  playerUserId   String
  guardianEmail  String
  guardianUserId String?
  status         ParentalConsentStatus @default(REQUIRED)
  requestedAt    DateTime              @default(now())
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player          User     @relation("ParentalConsentPlayer", fields: [playerUserId], references: [id], onDelete: Cascade)
  guardian        User?    @relation("ParentalConsentGuardian", fields: [guardianUserId], references: [id], onDelete: SetNull)
  approvalInvites Invite[]

  @@unique([teamId, playerUserId, guardianEmail])
  @@index([clubId])
  @@index([guardianEmail])
  @@index([guardianUserId])
}

// ─── Events + RSVP ─────────────────────────────────────

enum EventType {
  TRAINING
  MATCH
  OTHER
}

enum InjuryAvailabilityStatus {
  OUT
  DOUBTFUL
  DAY_TO_DAY
}

enum TeamDutyKind {
  JERSEY_CLEANUP
  BIB_CLEANUP
}

enum TeamDutyStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model Event {
  id               String    @id @default(cuid())
  clubId           String
  teamId           String
  externalMatchKey String?   @unique
  title            String
  type             EventType @default(TRAINING)
  date             DateTime
  location         String?
  notes            String?
  createdById      String
  cancelledAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  club                Club                      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team                Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy           User                      @relation("EventCreator", fields: [createdById], references: [id])
  rsvps               Rsvp[]
  reminderPreferences EventReminderPreference[]

  @@index([clubId])
  @@index([teamId])
  @@index([date])
}

model EventReminderPreference {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([remindAt, sent])
}

model InjuryReport {
  id                  String                   @id @default(cuid())
  clubId              String
  teamId              String
  userId              String
  reportedById        String
  title               String
  notes               String?
  status              InjuryAvailabilityStatus @default(OUT)
  expectedReturnAt    DateTime?
  expectedReturnLabel String?
  clearedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  club       Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team       Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User @relation("InjuryPlayer", fields: [userId], references: [id], onDelete: Cascade)
  reportedBy User @relation("InjuryReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([clubId, teamId])
  @@index([userId])
  @@index([reportedById])
  @@index([clearedAt])
}

model TeamDutyAssignment {
  id             String         @id @default(cuid())
  clubId         String
  teamId         String
  assignedUserId String
  createdById    String
  kind           TeamDutyKind
  status         TeamDutyStatus @default(PENDING)
  dueDate        DateTime?
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  club         Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedUser User @relation("DutyAssignee", fields: [assignedUserId], references: [id], onDelete: Cascade)
  createdBy    User @relation("DutyCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clubId, teamId])
  @@index([assignedUserId])
  @@index([createdById])
}

enum RsvpStatus {
  YES
  MAYBE
  NO
}

model Rsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// ─── Chat ───────────────────────────────────────────────

model Message {
  id             String      @id @default(cuid())
  clubId         String
  teamId         String
  channelId      String?
  senderId       String
  content        String
  sourceLanguage String? // ISO-639-1 detected by LibreTranslate; null if not yet detected
  messageType    MessageType @default(TEXT)
  attachmentUrl  String?
  attachmentMeta Json?
  replyToId      String?
  isAnnouncement Boolean     @default(false)
  isPinned       Boolean     @default(false)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())

  club         Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team         Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  channel      Channel?             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender       User                 @relation(fields: [senderId], references: [id])
  replyTo      Message?             @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]            @relation("MessageReply")
  reactions    MessageReaction[]
  reads        MessageReadReceipt[]
  reports      MessageReport[]
  poll         Poll?
  translations MessageTranslation[]

  @@index([teamId, createdAt])
  @@index([channelId, createdAt])
  @@index([clubId])
}

// Cached translations of Message.content per target language. Keyed by
// (messageId, targetLanguage) so each pair is computed at most once.
model MessageTranslation {
  id             String   @id @default(cuid())
  messageId      String
  targetLanguage String
  content        String
  createdAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, targetLanguage])
  @@index([messageId])
}

enum MessageType {
  TEXT
  VOICE
  IMAGE
  VIDEO
  FILE
  POLL
  RSVP_POLL
  LINEUP
  SYSTEM
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

// User-generated content moderation. Apple Guideline 1.2 requires a
// surface to report-this-content + block-this-user before approving any
// app with UGC chat. Reports are reviewed by club admins via the
// existing audit log; severe reports trigger a soft-delete on the
// message until reviewed.
model MessageReport {
  id             String    @id @default(cuid())
  messageId      String
  reporterUserId String
  reason         String // free-text + canonical reasons (SPAM/ABUSE/INAPPROPRIATE/OTHER)
  resolvedAt     DateTime?
  resolvedById   String?
  resolution     String? // free-text resolution note from admin
  createdAt      DateTime  @default(now())

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User    @relation("MessageReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterUserId])
  @@index([messageId])
  @@index([reporterUserId])
  @@index([resolvedAt])
}

// Per-user block. Blocking is uni-directional: blocker no longer sees
// blocked's messages or DMs. Symmetric blocks happen when both users
// block each other. Chat history filter excludes blocked-by-caller
// messages; DM list hides conversations with blocked users.
model UserBlock {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
}

model Channel {
  id          String            @id @default(cuid())
  clubId      String
  teamId      String?
  slug        String
  kind        ChannelKind
  name        String
  description String?
  visibility  ChannelVisibility @default(MEMBERS)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([clubId, teamId, slug])
  @@index([teamId])
  @@index([clubId])
}

enum ChannelKind {
  TEAM
  COACHES
  PARENTS
  ANNOUNCEMENTS
  CLUB_NEWS
  CUSTOM
}

enum ChannelVisibility {
  MEMBERS
  COACHES_ONLY
  PARENTS_ONLY
  ADMINS_ONLY
}

model Poll {
  id          String    @id @default(cuid())
  messageId   String    @unique
  question    String
  multiSelect Boolean   @default(false)
  closesAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  index  Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  votedAt  DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
}

// ─── Invites ────────────────────────────────────────────

model Invite {
  id                 String                @id @default(cuid())
  clubId             String
  teamId             String
  parentalConsentId  String?
  code               String                @unique // 8-char alphanumeric
  kind               InviteKind            @default(MEMBER_INVITE)
  role               TeamRole
  phase              TeamAccessPhase       @default(FULL)
  deliveryChannel    InviteDeliveryChannel
  recipientEmail     String?
  linkedPlayerUserId String?
  guardianEmail      String?
  childName          String?
  createdById        String
  acceptedByUserId   String?
  status             InviteStatus          @default(PENDING)
  expiresAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parentalConsent ParentalConsent? @relation(fields: [parentalConsentId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy      User?            @relation("InviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([clubId])
  @@index([teamId])
  @@index([recipientEmail])
  @@index([linkedPlayerUserId])
  @@index([guardianEmail])
}

model ExternalTeamLink {
  id             String                 @id @default(cuid())
  clubId         String
  teamId         String
  provider       ExternalDataProvider
  externalTeamId String
  externalClubId String?
  externalUrl    String
  label          String
  status         ExternalTeamLinkStatus @default(ACTIVE)
  lastSyncedAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  club     Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fixtures ImportedFixture[]
  syncRuns SyncRun[]

  @@unique([teamId, provider, externalTeamId])
  @@index([clubId, teamId])
  @@index([clubId, status])
}

model ImportedFixture {
  id               String                @id @default(cuid())
  clubId           String
  teamId           String
  teamLinkId       String
  provider         ExternalDataProvider
  externalMatchId  String
  competition      String
  season           String?
  kickoffAt        DateTime
  status           ImportedFixtureStatus @default(SCHEDULED)
  homeTeam         String
  awayTeam         String
  homeLogo         String?
  awayLogo         String?
  venueName        String?
  pitchAddress     String?
  resultHome       Int?
  resultAway       Int?
  tableSnapshot    Json?
  rawPayload       Json
  sourceConfidence FixtureDataConfidence @default(UNOFFICIAL_PUBLIC)
  lastSeenAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamLink ExternalTeamLink @relation(fields: [teamLinkId], references: [id], onDelete: Cascade)
  overlay  FixtureOverlay?

  @@unique([teamLinkId, externalMatchId])
  @@index([clubId, teamId, kickoffAt])
  @@index([clubId, lastSeenAt])
}

model FixtureOverlay {
  id            String    @id @default(cuid())
  clubId        String
  fixtureId     String    @unique
  arrivalTime   DateTime?
  meetingPoint  String?
  kitColor      String?
  travelNotes   String?
  squadDeadline DateTime?
  veoLink       String?
  fieldLocks    Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  club    Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fixture ImportedFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([clubId, updatedAt])
}

model SyncRun {
  id            String               @id @default(cuid())
  clubId        String
  teamLinkId    String
  provider      ExternalDataProvider
  status        SyncRunStatus
  importedCount Int                  @default(0)
  updatedCount  Int                  @default(0)
  skippedCount  Int                  @default(0)
  parserVersion String
  errorSummary  String?
  startedAt     DateTime             @default(now())
  completedAt   DateTime?
  createdAt     DateTime             @default(now())

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teamLink ExternalTeamLink @relation(fields: [teamLinkId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([teamLinkId, createdAt])
}

// ─── Push Tokens ────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // Expo push token
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Notification Preferences ───────────────────────────

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String
  clubId             String
  teamId             String? // null = club-wide default
  mutedChat          Boolean  @default(false)
  mutedEvents        Boolean  @default(false)
  mutedAnnouncements Boolean  @default(false)
  quietStart         String? // "22:00" HH:mm
  quietEnd           String? // "07:00" HH:mm
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId, teamId])
  @@index([userId, clubId])
}

model FreeAgentProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  position         PlayerPosition?
  preferredFoot    PreferredFoot?
  city             String?
  bio              String?
  isOnTransferList Boolean             @default(false)
  visibility       FreeAgentVisibility @default(PRIVATE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience   FreeAgentExperience[]
  media        FreeAgentMedia[]
  trialInvites TrialInvite[]

  @@index([isOnTransferList, visibility])
  @@index([city])
  @@index([position])
}

enum FreeAgentMediaType {
  PHOTO
  VIDEO
}

model FreeAgentMedia {
  id           String             @id @default(cuid())
  profileId    String
  type         FreeAgentMediaType
  url          String
  thumbnailUrl String?
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())

  profile FreeAgentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model FreeAgentExperience {
  id        String   @id @default(cuid())
  profileId String
  clubName  String
  roleLabel String
  fromYear  Int?
  toYear    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile FreeAgentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model TrialInvite {
  id                 String            @id @default(cuid())
  clubId             String
  freeAgentProfileId String
  teamId             String
  sentByUserId       String
  message            String?
  expiresAt          DateTime
  status             TrialInviteStatus @default(PENDING)
  respondedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  club             Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  freeAgentProfile FreeAgentProfile @relation(fields: [freeAgentProfileId], references: [id], onDelete: Cascade)
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender           User             @relation("TrialInviteSender", fields: [sentByUserId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
  @@index([freeAgentProfileId, status])
  @@index([teamId, status])
}

// ─── Billing ───────────────────────────────────────────

model StripeAccount {
  id                 String   @id @default(cuid())
  clubId             String   @unique
  stripeAccountId    String   @unique
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String   @id @default(cuid())
  clubId               String
  stripeSubscriptionId String   @unique
  status               String
  plan                 String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model PaymentEvent {
  id            String   @id @default(cuid())
  clubId        String
  stripeEventId String   @unique
  type          String
  amount        Int // cents
  currency      String   @default("eur")
  status        String
  createdAt     DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([createdAt])
}

model ClubContributionSettings {
  id                   String   @id @default(cuid())
  clubId               String   @unique
  enabled              Boolean  @default(false)
  autoRemindersEnabled Boolean  @default(true)
  defaultCurrency      String   @default("eur")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model ContributionPlan {
  id                 String                 @id @default(cuid())
  clubId             String
  name               String
  nameEn             String?
  nameDe             String?
  description        String?
  amount             Int
  currency           String                 @default("eur")
  cadence            ContributionCadence
  // Optional discount applied when the plan is paid yearly. 0-100
  // integer percent. Lets an admin offer "€25/mo OR €240/yr (20% off)"
  // on a single plan instead of two separate ones.
  yearlyDiscountPct  Int                    @default(0)
  targetRole         ContributionTargetRole
  dueDay             Int
  dueMonth           Int?
  graceDays          Int                    @default(0)
  reminderDaysBefore Int[]                  @default([])
  reminderDaysAfter  Int[]                  @default([])
  active             Boolean                @default(true)
  createdById        String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  club        Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("ContributionPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments ContributionAssignment[]
  records     ContributionRecord[]
  reminders   ContributionReminder[]

  @@index([clubId, active])
}

model ContributionAssignment {
  id           String    @id @default(cuid())
  clubId       String
  planId       String
  memberUserId String
  assignedById String
  startDate    DateTime  @default(now())
  endDate      DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan       ContributionPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  member     User                   @relation("ContributionMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  assignedBy User                   @relation("ContributionAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  records    ContributionRecord[]
  reminders  ContributionReminder[]

  @@unique([planId, memberUserId])
  @@index([clubId, memberUserId])
  @@index([clubId, endDate])
}

model ContributionRecord {
  id                 String                   @id @default(cuid())
  clubId             String
  planId             String
  assignmentId       String
  memberUserId       String
  periodStart        DateTime
  periodEnd          DateTime
  dueDate            DateTime
  amount             Int
  currency           String                   @default("eur")
  status             ContributionRecordStatus @default(PENDING)
  paidAmount         Int?
  paidAt             DateTime?
  note               String?
  lastReminderKey    String?
  lastReminderSentAt DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan       ContributionPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignment ContributionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  member     User                   @relation("ContributionRecordMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  reminders  ContributionReminder[]

  @@unique([assignmentId, periodStart])
  @@index([clubId, memberUserId, dueDate])
}

model ContributionReminder {
  id           String                      @id @default(cuid())
  clubId       String
  planId       String
  assignmentId String
  recordId     String
  memberUserId String
  trigger      ContributionReminderTrigger
  reminderKey  String
  emailSent    Boolean                     @default(false)
  pushSent     Boolean                     @default(false)
  status       ContributionReminderStatus  @default(SKIPPED)
  message      String?
  sentAt       DateTime                    @default(now())

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan       ContributionPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignment ContributionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  record     ContributionRecord     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member     User                   @relation("ContributionReminderMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@unique([recordId, reminderKey])
  @@index([clubId, memberUserId, sentAt])
}

model SupportAction {
  id         String   @id @default(cuid())
  action     String // IMPERSONATE | RESET_INVITE | SUSPEND_CLUB | RESTORE_CLUB | RESEND_BILLING_LINK
  clubId     String
  actorId    String
  actorEmail String
  note       String?
  metadata   Json? // action-specific payload (e.g. inviteId for RESET_INVITE)
  createdAt  DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([actorId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  clubId     String?
  type       String // AuditEventType values
  actorType  String // 'system' | 'user' | 'admin'
  actorId    String?
  actorLabel String?
  summary    String
  metadata   Json? // extra context
  createdAt  DateTime @default(now())

  club Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([type])
}

// ─── Join Request (request-to-join flow) ────────────────

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlayerPosition {
  GK
  DEF
  MID
  FWD
}

enum ContributionCadence {
  MONTHLY
  YEARLY
}

enum ContributionTargetRole {
  PLAYER
  PARENT
  COACH
  ADMIN
  CUSTOM
}

enum ContributionRecordStatus {
  PENDING
  PAID
  PARTIAL
  WAIVED
  EXEMPT
}

enum ContributionReminderTrigger {
  AUTOMATIC
  MANUAL
}

enum ContributionReminderStatus {
  SENT
  SKIPPED
  FAILED
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

enum FreeAgentVisibility {
  PUBLIC
  CLUB_ONLY
  PRIVATE
}

enum TrialInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

model JoinRequest {
  id         String            @id @default(cuid())
  clubId     String
  teamId     String?
  userId     String
  role       TeamRole          @default(PLAYER)
  message    String?           @db.VarChar(500)
  status     JoinRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([clubId, userId])
  @@index([clubId, status])
}

// ─── Direct Messages ────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([clubId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("DirectMessageSender", fields: [senderId], references: [id])
  content        String
  sourceLanguage String?
  createdAt      DateTime     @default(now())

  translations DirectMessageTranslation[]

  @@index([conversationId, createdAt])
}

model DirectMessageTranslation {
  id              String   @id @default(cuid())
  directMessageId String
  targetLanguage  String
  content         String
  createdAt       DateTime @default(now())

  directMessage DirectMessage @relation(fields: [directMessageId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, targetLanguage])
  @@index([directMessageId])
}

// ─── Roster Slots ────────────────────────────────────────

model RosterSlot {
  id              String          @id @default(cuid())
  teamId          String
  fullName        String
  phone           String?
  dateOfBirth     DateTime?
  position        PlayerPosition?
  jerseyNumber    Int?
  claimedByUserId String?         @unique
  claimedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  claimedBy User? @relation(fields: [claimedByUserId], references: [id])

  @@index([teamId])
  @@index([teamId, claimedByUserId])
  @@index([phone])
}

// ─── Sponsor logos (Plus feature) ──────────────────────
//
// Clubs on the PREMIUM plan can upload kit-sponsor logos and surface
// them across the app (home screen strip, profile page, etc.).
// Reads are unauthenticated-by-plan — once a club downgrades, their
// existing sponsors stay visible & deletable so they can clean up,
// but new writes are gated on the `sponsor_logos` entitlement.

model Sponsor {
  id           String   @id @default(cuid())
  clubId       String
  name         String
  logoUrl      String
  linkUrl      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([clubId, displayOrder])
}
