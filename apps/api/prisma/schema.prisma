// Anstoss — Prisma Schema
//
// Club operating model:
//   User (global) → Membership (club tenancy) → TeamGroup (umbrella) → Team (squad)
//   Team visibility and permissions flow through TeamAccess.
//   TeamMember remains player-specific roster metadata.
//
// Tenant scoping: clubId on every tenant-scoped model.
// Prisma middleware auto-injects clubId on all queries for tenant-scoped models.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

// ─── Global Models ──────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String   @unique
  name        String
  avatarUrl   String?
  dateOfBirth DateTime? // Nullable — age gate guard forces DOB entry if null
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships                 Membership[]
  teamMembers                 TeamMember[]
  teamAccess                  TeamAccess[]
  guardianRelationshipsAsParent GuardianRelationship[] @relation("GuardianParent")
  guardianRelationshipsAsPlayer GuardianRelationship[] @relation("GuardianPlayer")
  parentalConsentsAsPlayer    ParentalConsent[]       @relation("ParentalConsentPlayer")
  parentalConsentsAsGuardian  ParentalConsent[]       @relation("ParentalConsentGuardian")
  createdInvites              Invite[]                @relation("InviteCreator")
  acceptedInvites             Invite[]                @relation("InviteAcceptor")
  rsvps                       Rsvp[]
  messages                    Message[]
  events                      Event[]                 @relation("EventCreator")
  pushTokens                  PushToken[]
  notificationPreferences     NotificationPreference[]
  joinRequests                JoinRequest[]

  @@index([clerkId])
  @@index([email])
}

// ─── Tenant Root ────────────────────────────────────────

model Club {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  badgeUrl     String?
  primaryColor String   @default("#1A1A18") // hex, overridden by coach
  welcomeText  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           Membership[]
  teamGroups            TeamGroup[]
  teams                 Team[]
  teamAccess            TeamAccess[]
  guardianRelationships GuardianRelationship[]
  parentalConsents      ParentalConsent[]
  externalTeamLinks     ExternalTeamLink[]
  importedFixtures      ImportedFixture[]
  fixtureOverlays       FixtureOverlay[]
  syncRuns              SyncRun[]
  events                Event[]
  messages              Message[]
  invites               Invite[]
  stripeAccount         StripeAccount?
  subscriptions         Subscription[]
  paymentEvents         PaymentEvent[]
  supportActions        SupportAction[]
  auditLogs             AuditLog[]
  joinRequests          JoinRequest[]

  @@index([slug])
}

// ─── Membership (User ↔ Club bridge) ────────────────────

enum MembershipRole {
  OWNER
  ADMIN
  COACH
  PLAYER
  PARENT
}

enum TeamGroupType {
  SENIOR
  YOUTH
  MINI
  CUSTOM
}

enum TeamRole {
  HEAD_COACH
  ASSISTANT_COACH
  PLAYER
  PARENT
}

enum TeamAccessPhase {
  FULL
  TRIAL
}

enum TeamAccessStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum InviteKind {
  MEMBER_INVITE
  PARENT_APPROVAL
}

enum InviteDeliveryChannel {
  EMAIL
  LINK
}

enum InviteStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ParentalConsentStatus {
  REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ExternalDataProvider {
  API_FUSSBALL
  FUSSBALL_PUBLIC_PAGE
  OPENLIGADB
  CLUB_MANUAL
  WIDGET_EMBED
  WEATHER
  MAPS
  VEO_MANUAL
}

enum ExternalTeamLinkStatus {
  ACTIVE
  NEEDS_REVIEW
  ERROR
  DISCONNECTED
}

enum ImportedFixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
  UNKNOWN
}

enum FixtureDataConfidence {
  OFFICIAL_PARTNER
  OFFICIAL_WIDGET
  UNOFFICIAL_PUBLIC
  COMMUNITY_OPEN
  CLUB_ENTERED
  MIXED
}

enum SyncRunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  clubId    String
  role      MembershipRole @default(PLAYER)
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@index([userId])
}

// ─── Team hierarchy ─────────────────────────────────────

model TeamGroup {
  id          String        @id @default(cuid())
  clubId      String
  type        TeamGroupType
  displayName String
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  club  Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teams Team[]

  @@index([clubId, sortOrder])
  @@unique([clubId, displayName])
}

model Team {
  id          String   @id @default(cuid())
  clubId      String
  groupId     String
  name        String
  displayName String
  ageGroup    String?
  squadLabel  String?
  leagueName  String?
  seasonStart DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club              Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  group             TeamGroup              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  access            TeamAccess[]
  loanedPlayers     TeamAccess[]           @relation("LoanSource")
  guardianLinks     GuardianRelationship[]
  parentalConsents  ParentalConsent[]
  externalTeamLinks ExternalTeamLink[]
  importedFixtures  ImportedFixture[]
  invites           Invite[]
  events            Event[]
  messages          Message[]

  @@index([clubId])
  @@index([groupId])
  @@unique([groupId, displayName])
}

model TeamMember {
  id           String  @id @default(cuid())
  teamId       String
  userId       String
  position     String?
  jerseyNumber Int?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamAccess {
  id        String           @id @default(cuid())
  clubId    String
  teamId    String
  userId    String
  role      TeamRole
  phase     TeamAccessPhase  @default(FULL)
  status    TeamAccessStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Loan fields — player temporarily assigned from another team
  loanedFromTeamId String?
  loanStartDate    DateTime?
  loanEndDate      DateTime?

  club           Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team           Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanedFromTeam Team? @relation("LoanSource", fields: [loanedFromTeamId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId, role])
  @@index([clubId])
  @@index([teamId])
  @@index([userId])
  @@index([loanedFromTeamId])
}

model GuardianRelationship {
  id           String   @id @default(cuid())
  clubId       String
  teamId       String?
  parentUserId String
  playerUserId String?
  childName    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club   Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team   Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent User  @relation("GuardianParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  player User? @relation("GuardianPlayer", fields: [playerUserId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([teamId])
  @@index([parentUserId])
  @@index([playerUserId])
}

model ParentalConsent {
  id            String                @id @default(cuid())
  clubId        String
  teamId        String
  playerUserId  String
  guardianEmail String
  guardianUserId String?
  status        ParentalConsentStatus @default(REQUIRED)
  requestedAt   DateTime              @default(now())
  approvedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  club             Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player           User     @relation("ParentalConsentPlayer", fields: [playerUserId], references: [id], onDelete: Cascade)
  guardian         User?    @relation("ParentalConsentGuardian", fields: [guardianUserId], references: [id], onDelete: SetNull)
  approvalInvites  Invite[]

  @@unique([teamId, playerUserId, guardianEmail])
  @@index([clubId])
  @@index([guardianEmail])
  @@index([guardianUserId])
}

// ─── Events + RSVP ─────────────────────────────────────

enum EventType {
  TRAINING
  MATCH
  OTHER
}

model Event {
  id          String    @id @default(cuid())
  clubId      String
  teamId      String
  externalMatchKey String? @unique
  title       String
  type        EventType @default(TRAINING)
  date        DateTime
  location    String?
  notes       String?
  createdById String
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club      Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User   @relation("EventCreator", fields: [createdById], references: [id])
  rsvps     Rsvp[]

  @@index([clubId])
  @@index([teamId])
  @@index([date])
}

enum RsvpStatus {
  YES
  MAYBE
  NO
}

model Rsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// ─── Chat ───────────────────────────────────────────────

model Message {
  id             String   @id @default(cuid())
  clubId         String
  teamId         String
  senderId       String
  content        String
  isAnnouncement Boolean  @default(false)
  isPinned       Boolean  @default(false)
  createdAt      DateTime @default(now())

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([teamId, createdAt])
  @@index([clubId])
}

// ─── Invites ────────────────────────────────────────────

model Invite {
  id               String                @id @default(cuid())
  clubId           String
  teamId           String
  parentalConsentId String?
  code             String                @unique // 8-char alphanumeric
  kind             InviteKind            @default(MEMBER_INVITE)
  role             TeamRole
  phase            TeamAccessPhase       @default(FULL)
  deliveryChannel  InviteDeliveryChannel
  recipientEmail   String?
  linkedPlayerUserId String?
  guardianEmail    String?
  childName        String?
  createdById      String
  acceptedByUserId String?
  status           InviteStatus          @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parentalConsent ParentalConsent? @relation(fields: [parentalConsentId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy      User?            @relation("InviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([clubId])
  @@index([teamId])
  @@index([recipientEmail])
  @@index([linkedPlayerUserId])
  @@index([guardianEmail])
}

model ExternalTeamLink {
  id             String                 @id @default(cuid())
  clubId         String
  teamId         String
  provider       ExternalDataProvider
  externalTeamId String
  externalClubId String?
  externalUrl    String
  label          String
  status         ExternalTeamLinkStatus @default(ACTIVE)
  lastSyncedAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  club           Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team           Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fixtures       ImportedFixture[]
  syncRuns       SyncRun[]

  @@unique([teamId, provider, externalTeamId])
  @@index([clubId, teamId])
  @@index([clubId, status])
}

model ImportedFixture {
  id               String                 @id @default(cuid())
  clubId           String
  teamId           String
  teamLinkId       String
  provider         ExternalDataProvider
  externalMatchId  String
  competition      String
  season           String?
  kickoffAt        DateTime
  status           ImportedFixtureStatus  @default(SCHEDULED)
  homeTeam         String
  awayTeam         String
  homeLogo         String?
  awayLogo         String?
  venueName        String?
  pitchAddress     String?
  resultHome       Int?
  resultAway       Int?
  tableSnapshot    Json?
  rawPayload       Json
  sourceConfidence FixtureDataConfidence  @default(UNOFFICIAL_PUBLIC)
  lastSeenAt       DateTime               @default(now())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamLink ExternalTeamLink @relation(fields: [teamLinkId], references: [id], onDelete: Cascade)
  overlay  FixtureOverlay?

  @@unique([teamLinkId, externalMatchId])
  @@index([clubId, teamId, kickoffAt])
  @@index([clubId, lastSeenAt])
}

model FixtureOverlay {
  id            String   @id @default(cuid())
  clubId        String
  fixtureId     String   @unique
  arrivalTime   DateTime?
  meetingPoint  String?
  kitColor      String?
  travelNotes   String?
  squadDeadline DateTime?
  veoLink       String?
  fieldLocks    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  club    Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fixture ImportedFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([clubId, updatedAt])
}

model SyncRun {
  id           String               @id @default(cuid())
  clubId       String
  teamLinkId   String
  provider     ExternalDataProvider
  status       SyncRunStatus
  importedCount Int                 @default(0)
  updatedCount Int                  @default(0)
  skippedCount Int                  @default(0)
  parserVersion String
  errorSummary String?
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  createdAt    DateTime             @default(now())

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teamLink ExternalTeamLink @relation(fields: [teamLinkId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([teamLinkId, createdAt])
}

// ─── Push Tokens ────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // Expo push token
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Notification Preferences ───────────────────────────

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String
  clubId             String
  teamId             String?  // null = club-wide default
  mutedChat          Boolean  @default(false)
  mutedEvents        Boolean  @default(false)
  mutedAnnouncements Boolean  @default(false)
  quietStart         String?  // "22:00" HH:mm
  quietEnd           String?  // "07:00" HH:mm
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId, teamId])
  @@index([userId, clubId])
}

// ─── Billing ───────────────────────────────────────────

model StripeAccount {
  id                 String   @id @default(cuid())
  clubId             String   @unique
  stripeAccountId    String   @unique
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String   @id @default(cuid())
  clubId               String
  stripeSubscriptionId String   @unique
  status               String
  plan                 String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model PaymentEvent {
  id            String   @id @default(cuid())
  clubId        String
  stripeEventId String   @unique
  type          String
  amount        Int      // cents
  currency      String   @default("eur")
  status        String
  createdAt     DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([createdAt])
}

model SupportAction {
  id         String   @id @default(cuid())
  action     String   // IMPERSONATE | RESET_INVITE | SUSPEND_CLUB | RESTORE_CLUB | RESEND_BILLING_LINK
  clubId     String
  actorId    String
  actorEmail String
  note       String?
  metadata   Json?    // action-specific payload (e.g. inviteId for RESET_INVITE)
  createdAt  DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([actorId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  clubId     String?
  type       String   // AuditEventType values
  actorType  String   // 'system' | 'user' | 'admin'
  actorId    String?
  actorLabel String?
  summary    String
  metadata   Json?    // extra context
  createdAt  DateTime @default(now())

  club Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([type])
}

// ─── Join Request (request-to-join flow) ────────────────

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model JoinRequest {
  id         String            @id @default(cuid())
  clubId     String
  teamId     String?
  userId     String
  role       TeamRole          @default(PLAYER)
  message    String?           @db.VarChar(500)
  status     JoinRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([clubId, userId])
  @@index([clubId, status])
}
