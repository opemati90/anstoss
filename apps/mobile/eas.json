{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "image": "sdk-56"
      }
    },
    "preview": {
      "credentialsSource": "remote",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "image": "sdk-56"
      }
    },
    "testflight": {
      "credentialsSource": "remote",
      "distribution": "store",
      "channel": "testflight",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_STAGE": "testflight",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "ios": {
        "image": "sdk-56"
      },
      "android": {
        "image": "sdk-56"
      }
    },
    "production": {
      "credentialsSource": "remote",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_STAGE": "production",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "ios": {
        "image": "sdk-56"
      },
      "android": {
        "image": "sdk-56"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6761143230"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6761143230"
      }
    }
  }
}
