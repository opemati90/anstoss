{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "image": "ubuntu-22.04-jdk-17-ndk-r26b"
      }
    },
    "preview": {
      "credentialsSource": "remote",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "image": "ubuntu-22.04-jdk-17-ndk-r26b"
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "testflight",
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "image": "ubuntu-22.04-jdk-17-ndk-r26b"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "image": "ubuntu-22.04-jdk-17-ndk-r26b"
      }
    }
  }
}
