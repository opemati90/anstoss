# Anstoss Mobile — Environment Variables
# Copy to .env and fill in values

# API URL
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sentry (mobile DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Stripe — Anstoss Plus subscription Price IDs (test mode).
# Create a Product called "Anstoss Plus" in Stripe Dashboard (test mode),
# add two recurring prices (€29 / month and €290 / year), then paste the
# `price_…` IDs below. Without these, PaywallSheet renders but the Upgrade
# button shows the "Upgrade unavailable" alert.
EXPO_PUBLIC_STRIPE_PLUS_PRICE_ID=price_test_xxxxxxxxxxxxxx
EXPO_PUBLIC_STRIPE_PLUS_YEARLY_PRICE_ID=price_test_xxxxxxxxxxxxxx
