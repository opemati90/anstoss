{
  "expo": {
    "name": "Anstoss",
    "slug": "anstoss",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "anstoss",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "bundleIdentifier": "com.renuirug.anstoss",
      "appleTeamId": "A3H3NSC234",
      "associatedDomains": [
        "applinks:anstoss.io",
        "applinks:api.anstoss.io"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "EXExpoAppSceneDelegate"
              }
            ]
          }
        }
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF8"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.renuirug.anstoss",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "anstoss.io",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": "57.0.1-billing2-auth1"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.387307271714-7ucmis3qn03b8canv0ucijfk98imhvbm"
        }
      ],
      "expo-iap",
      "expo-router",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Anstoss to let you choose profile, club, sponsor, and chat images.",
          "cameraPermission": "Allow Anstoss to take photos for profiles, club media, sponsors, and chat.",
          "microphonePermission": "Allow Anstoss to record voice messages for your team chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Anstoss to record voice messages for your team chat.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B1B1B"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "anstoss",
          "project": "anstoss-mobile"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF8"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a30e1b35-50fa-4214-b121-f457dfb1444c"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "opemati1521",
    "runtimeVersion": "57.0.1-billing2-auth1",
    "updates": {
      "url": "https://u.expo.dev/a30e1b35-50fa-4214-b121-f457dfb1444c"
    }
  }
}
