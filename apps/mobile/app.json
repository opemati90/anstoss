{
  "expo": {
    "name": "Anstoss",
    "slug": "anstoss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "anstoss",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.renuirug.anstoss",
      "appleTeamId": "A3H3NSC234",
      "associatedDomains": ["applinks:anstoss.io", "applinks:api.anstoss.io"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF8"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.renuirug.anstoss",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "anstoss.io",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Anstoss to let you choose profile, club, sponsor, and chat images.",
          "cameraPermission": "Allow Anstoss to take photos for profiles, club media, sponsors, and chat.",
          "microphonePermission": "Allow Anstoss to record voice messages for your team chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Anstoss to record voice messages for your team chat.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B1B1B"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "anstoss",
          "project": "anstoss-mobile"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "a30e1b35-50fa-4214-b121-f457dfb1444c"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "opemati1521",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a30e1b35-50fa-4214-b121-f457dfb1444c"
    }
  }
}
