# Runtime env for the internal admin static service.
# Set these on the Railway admin service, not in source control.

# Optional. Defaults to the production API. Leave blank in the browser UI so
# requests use the same-origin nginx proxy and avoid browser CORS.
API_UPSTREAM=https://anstoss-api-production.up.railway.app

# Admin login credentials now live on the API service, which validates the
# username/password and issues a short-lived admin-console session token.
# Set these on the Railway API service, not here.
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD_HASH=scrypt$<hex-salt>$<hex-hash>
ADMIN_CONSOLE_EMAIL=admin@anstoss.io
ADMIN_CONSOLE_NAME=Anstoss Platform Admin
